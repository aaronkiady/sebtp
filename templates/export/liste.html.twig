{% extends 'base.html.twig' %}

{% block title %}Export des adhérents{% endblock %}

{% block body %}
<div class="main-wrapper mt-5">
    <div class="form-card-wide p-4">
        <div class="d-flex justify-content-between align-items-start mb-4">
            <div class="d-flex align-items-center">
                <div class="header-icon" style="background: var(--primary-light); color: var(--primary);">
                    <i class="fas fa-users"></i>
                </div>
                <div>
                    <h1 class="h2 fw-bold text-dark mb-0">Export des adhérents</h1>
                    <p class="text-muted mb-0">Générez un fichier Excel des adhérents</p>
                </div>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <form method="get" action="{{ path('app_export_liste_excel') }}" class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Statut adhérent</label>
                        <select name="statut" class="form-select">
                            <option value="">Tous les statuts</option>
                            {% for statut in statuts %}
                                <option value="{{ statut }}">{{ statut|capitalize }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Statut membre</label>
                        <select name="statutMenmbre" class="form-select">
                            <option value="">Tous</option>
                            {% for statutMembre in statutsMembres %}
                                <option value="{{ statutMembre }}">{{ statutMembre|capitalize }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Filière</label>
                        <select name="filiere" class="form-select">
                            <option value="">Toutes les filières</option>
                            {% for filiere in filieres %}
                                <option value="{{ filiere }}">{{ filiere }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Activité</label>
                        <select name="activite" class="form-select">
                            <option value="">Toutes les activités</option>
                            {% for activite in activites %}
                                <option value="{{ activite }}">{{ activite }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Recherche</label>
                        <input type="text" name="search" class="form-control" placeholder="Nom, email, téléphone...">
                    </div>

                    <div class="col-md-4 d-flex align-items-end">
                        <button type="submit" class="btn btn-success w-100">
                            <i class="fas fa-file-excel me-2"></i>Exporter en Excel
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="alert alert-info mt-4">
            <i class="fas fa-info-circle me-2"></i>
            <strong>Informations :</strong> L'export inclura les colonnes suivantes :
            <ul class="mt-2 mb-0">
                <li>Nom, Email, Téléphone, Adresse, Site web</li>
                <li>Activité, Filière, Nombre d'employés</li>
                <li>Directeur général et ses coordonnées</li>
                <li>Statut, Statut membre, Fonction SEBTP, Mandat</li>
            </ul>
        </div>
    </div>
</div>
{% endblock %}