{% extends 'base.html.twig' %}

{% block title %}Export des cotisations{% endblock %}

{% block body %}
<div class="main-wrapper mt-5">
    <div class="form-card-wide p-4">
        <div class="d-flex justify-content-between align-items-start mb-4">
            <div class="d-flex align-items-center">
                <div class="header-icon" style="background: var(--primary-light); color: var(--primary);">
                    <i class="fas fa-file-excel"></i>
                </div>
                <div>
                    <h1 class="h2 fw-bold text-dark mb-0">Export des cotisations</h1>
                    <p class="text-muted mb-0">Générez un fichier Excel des cotisations</p>
                </div>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <form method="get" action="{{ path('app_export_cotisations') }}" class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Année</label>
                        <select name="annee" class="form-select">
                            <option value="">Toutes les années</option>
                            {% set currentYear = "now"|date('Y') %}
                            {% set selectedAnnee = app.request.query.get('annee') %}
                            
                            <option value="{{ currentYear }}" {% if selectedAnnee == currentYear or selectedAnnee is empty %}selected{% endif %}>
                                {{ currentYear }} (Année en cours)
                            </option>
                            <option value="{{ currentYear - 1 }}" {% if selectedAnnee == currentYear - 1 %}selected{% endif %}>
                                {{ currentYear - 1 }} (Année précédente)
                            </option>
                        </select>    
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Statut cotisation</label>
                        <select name="statut" class="form-select">
                            <option value="tous" {% if app.request.query.get('statut') == 'tous' or app.request.query.get('statut') is empty %}selected{% endif %}>Tous</option>
                            <option value="paye" {% if app.request.query.get('statut') == 'paye' %}selected{% endif %}>Payé</option>
                            <option value="impaye" {% if app.request.query.get('statut') == 'impaye' %}selected{% endif %}>Impayé</option>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Statut adhérent</label>
                        <select name="statutAdherent" class="form-select">
                            <option value="tous" {% if app.request.query.get('statutAdherent') == 'tous' or app.request.query.get('statutAdherent') is empty %}selected{% endif %}>Tous</option>
                            <option value="Actif" {% if app.request.query.get('statutAdherent') == 'Actif' %}selected{% endif %}>Actif</option>
                            <option value="Inactif" {% if app.request.query.get('statutAdherent') == 'Inactif' %}selected{% endif %}>Inactif</option>
                            <option value="Radié" {% if app.request.query.get('statutAdherent') == 'Radié' %}selected{% endif %}>Radié</option>
                        </select>
                    </div>

                    <div class="col-md-3 d-flex align-items-end">
                        <button type="submit" class="btn btn-success w-100">
                            <i class="fas fa-file-excel me-2"></i>Exporter en Excel
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="alert alert-info mt-4">
            <i class="fas fa-info-circle me-2"></i>
            <strong>Informations :</strong> L'export inclura les colonnes suivantes :
            <ul class="mt-2 mb-0">
                <li>Adhérent (nom, email, téléphone, adresse)</li>
                <li>Année de cotisation</li>
                <li>Montant et référence</li>
                <li>Statut et observation</li>
            </ul>
        </div>
    </div>
</div>
{% endblock %}