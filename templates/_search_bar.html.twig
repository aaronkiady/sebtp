<form method="get" class="mb-4">
    <div class="input-group custom-search-group shadow-sm">
        <span class="input-group-text bg-white border-end-0 rounded-start-4">
            <i class="fas fa-search text-muted"></i>
        </span>
        <input type="text" name="q" value="{{ app.request.query.get('q') }}" 
               class="form-control border-start-0 rounded-end-4 custom-input" 
               placeholder="Rechercher...">
        <button class="btn-action btn-update ms-2 rounded-4" type="submit">Filtrer</button>
        {% if app.request.query.get('q') %}
            <a href="{{ app.request.pathInfo }}" class="btn-action btn-cancel ms-2 rounded-4 text-decoration-none">Effacer</a>
        {% endif %}
    </div>
</form>