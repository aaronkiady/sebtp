{% extends 'base.html.twig' %}

{% block title %}Détail audit - {{ log.action }}{% endblock %}

{% block body %}
<div class="main-wrapper mt-5">
    <div class="form-card-wide p-4">
        <div class="d-flex justify-content-between align-items-start mb-4">
            <div class="d-flex align-items-center">
                <a href="{{ path('app_audit_index') }}" class="btn btn-outline-secondary btn-sm shadow-sm me-3">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <div class="header-icon" style="background: var(--primary-light); color: var(--primary);">
                    <i class="fas fa-history"></i>
                </div>
                <div>
                    <h1 class="h2 fw-bold text-dark mb-0">Détail de l'action</h1>
                    <p class="text-muted mb-0">{{ log.createdAt|date('d/m/Y H:i:s') }}</p>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-white fw-bold">
                        <i class="fas fa-info-circle me-2 text-primary"></i>Action
                    </div>
                    <div class="card-body text-center">
                        {% if log.action == 'CREATE' %}
                            <i class="fas fa-plus-circle fa-3x text-success mb-2"></i>
                            <h4 class="text-success">Création</h4>
                        {% elseif log.action == 'UPDATE' %}
                            <i class="fas fa-edit fa-3x text-primary mb-2"></i>
                            <h4 class="text-primary">Modification</h4>
                        {% elseif log.action == 'DELETE' %}
                            <i class="fas fa-trash-alt fa-3x text-danger mb-2"></i>
                            <h4 class="text-danger">Suppression</h4>
                        {% elseif log.action == 'EXPORT' %}
                            <i class="fas fa-file-excel fa-3x text-info mb-2"></i>
                            <h4 class="text-info">Export</h4>
                        {% elseif log.action == 'PAYMENT' %}
                            <i class="fas fa-money-bill-wave fa-3x text-warning mb-2"></i>
                            <h4 class="text-warning">Paiement</h4>
                        {% endif %}
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-white fw-bold">
                        <i class="fas fa-building me-2 text-primary"></i>Entité concernée
                    </div>
                    <div class="card-body text-center">
                        <h3 class="text-primary mb-0">{{ log.entityType }}</h3>
                        <span class="badge bg-secondary mt-2">ID #{{ log.entityId }}</span>
                        {% if log.entityLabel %}
                            <p class="mt-3 mb-0 text-muted">{{ log.entityLabel }}</p>
                        {% endif %}
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-white fw-bold">
                        <i class="fas fa-user me-2 text-primary"></i>Utilisateur
                    </div>
                    <div class="card-body text-center">
                        <i class="fas fa-user-circle fa-3x text-secondary mb-2"></i>
                        <h5 class="mb-0">{{ log.userEmail|default('Utilisateur inconnu') }}</h5>
                        <small class="text-muted">IP: {{ log.userIp|default('-') }}</small>
                    </div>
                </div>
            </div>

            {% if log.oldData or log.newData %}
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-header bg-white fw-bold">
                        <i class="fas fa-exchange-alt me-2 text-primary"></i>Détail des modifications
                    </div>
                    <div class="card-body">
                        {% set oldData = log.oldData ? log.oldData|json_decode : null %}
                        {% set newData = log.newData ? log.newData|json_decode : null %}
                        
                        {% if oldData and newData %}
                            {% for key, value in oldData %}
                                {% set newValue = newData[key] ?? null %}
                                {% if value != newValue %}
                                    <div class="row mb-3 pb-3 border-bottom">
                                        <div class="col-md-3">
                                            <strong class="text-primary">{{ key|capitalize }}</strong>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="bg-light p-2 rounded">
                                                <small class="text-muted">Ancienne valeur :</small>
                                                <div class="text-danger">
                                                    {% if value is iterable %}
                                                        <ul class="mb-0">
                                                            {% for k, v in value %}
                                                                <li><strong>{{ k }}:</strong> {{ v }}</li>
                                                            {% endfor %}
                                                        </ul>
                                                    {% else %}
                                                        {{ value }}
                                                    {% endif %}
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-5">
                                            <div class="bg-light p-2 rounded">
                                                <small class="text-muted">Nouvelle valeur :</small>
                                                <div class="text-success">
                                                    {% if newValue is iterable %}
                                                        <ul class="mb-0">
                                                            {% for k, v in newValue %}
                                                                <li><strong>{{ k }}:</strong> {{ v }}</li>
                                                            {% endfor %}
                                                        </ul>
                                                    {% else %}
                                                        {{ newValue }}
                                                    {% endif %}
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                {% endif %}
                            {% endfor %}
                        {% elseif oldData %}
                            <div class="alert alert-danger">
                                <i class="fas fa-trash-alt me-2"></i>
                                <strong>Données supprimées :</strong>
                                <ul class="mt-2 mb-0">
                                    {% for key, value in oldData %}
                                        <li><strong>{{ key|capitalize }}:</strong> {{ value }}</li>
                                    {% endfor %}
                                </ul>
                            </div>
                        {% elseif newData %}
                            <div class="alert alert-success">
                                <i class="fas fa-plus-circle me-2"></i>
                                <strong>Données créées :</strong>
                                <ul class="mt-2 mb-0">
                                    {% for key, value in newData %}
                                        <li><strong>{{ key|capitalize }}:</strong> {{ value }}</li>
                                    {% endfor %}
                                </ul>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
            {% endif %}
        </div>

        <div class="mt-4 pt-3 border-top">
            <a href="{{ path('app_audit_index') }}" class="btn-action btn-cancel text-decoration-none">
                <i class="fas fa-arrow-left me-1"></i> Retour à la liste
            </a>
        </div>
    </div>
</div>
{% endblock %}