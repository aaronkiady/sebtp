{% extends 'base.html.twig' %}

{% block title %}Détail audit - {{ log.action }}{% endblock %}

{% block body %}
<div class="main-wrapper mt-5">
    <div class="form-card-wide p-4">
        <div class="d-flex justify-content-between align-items-start mb-4">
            <div class="d-flex align-items-center">
                <a href="{{ path('app_audit_index') }}" class="btn btn-outline-secondary btn-sm shadow-sm me-3">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <div class="header-icon" style="background: var(--primary-light); color: var(--primary);">
                    <i class="fas fa-history"></i>
                </div>
                <div>
                    <h1 class="h2 fw-bold text-dark mb-0">Détail de l'action</h1>
                    <p class="text-muted mb-0">{{ log.createdAt|date('d/m/Y H:i:s') }}</p>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-md-6">
                <div class="card shadow-sm">
                    <div class="card-header bg-white fw-bold">
                        <i class="fas fa-info-circle me-2 text-primary"></i>Informations générales
                    </div>
                    <div class="card-body">
                        <table class="table table-borderless">
                            <tbody>
                                <tr>
                                    <th style="width: 140px;">Action</th>
                                    <td>
                                        {% if log.action == 'CREATE' %}
                                            <span class="badge bg-success">Création</span>
                                        {% elseif log.action == 'UPDATE' %}
                                            <span class="badge bg-primary">Modification</span>
                                        {% elseif log.action == 'DELETE' %}
                                            <span class="badge bg-danger">Suppression</span>
                                        {% elseif log.action == 'EXPORT' %}
                                            <span class="badge bg-info">Export</span>
                                        {% elseif log.action == 'PAYMENT' %}
                                            <span class="badge bg-warning">Paiement</span>
                                        {% endif %}
                                    </td>
                                </tr>
                                <tr>
                                    <th>Entité</th>
                                    <td class="fw-bold">{{ log.entityType }}</td>
                                </tr>
                                <tr>
                                    <th>ID entité</th>
                                    <td class="text-muted">#{{ log.entityId }}</td>
                                </tr>
                                <tr>
                                    <th>Label</th>
                                    <td>{{ log.entityLabel|default('-') }}</td>
                                </tr>
                                {% if log.additionalInfo %}
                                <tr>
                                    <th>Info complémentaire</th>
                                    <td>{#<span class="badge bg-secondary">#}{{ log.additionalInfo }}</span></td>
                                </tr>
                                {% endif %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card shadow-sm">
                    <div class="card-header bg-white fw-bold">
                        <i class="fas fa-user me-2 text-primary"></i>Informations utilisateur
                    </div>
                    <div class="card-body">
                        <table class="table table-borderless">
                            <tbody>
                                <tr>
                                    <th style="width: 140px;">Utilisateur</th>
                                    <td class="fw-bold">{{ log.userEmail|default('-') }}</td>
                                </tr>
                                {#<tr>
                                    <th>ID utilisateur</th>
                                    <td class="text-muted">{{ log.userId|default('-') }}</td>
                                </tr>
                                <tr>
                                    <th>Adresse IP</th>
                                    <td><code>{{ log.userIp|default('-') }}</code></td>
                                </tr>
                                <tr>
                                    <th>Route</th>
                                    <td><span class="text-muted small">{{ log.route|default('-') }}</span></td>
                                </tr>
                                <tr>#}
                                    <th>Date</th>
                                    <td>{{ log.createdAt|date('d/m/Y H:i:s') }}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            {% if oldData or newData %}
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-header bg-white fw-bold">
                        <i class="fas fa-exchange-alt me-2 text-primary"></i>Détail des données
                    </div>
                    <div class="card-body p-0">
                        {% if oldData and newData %}
                            <div class="table-responsive">
                                <table class="table table-bordered mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th style="width: 33%">Champ</th>
                                            <th style="width: 33%">Ancienne valeur</th>
                                            <th style="width: 34%">Nouvelle valeur</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {# Récupérer toutes les clés uniques des deux tableaux #}
                                        {% set allKeys = [] %}
                                        {% for key in oldData|keys %}
                                            {% set allKeys = allKeys|merge([key]) %}
                                        {% endfor %}
                                        {% for key in newData|keys %}
                                            {% if key not in allKeys %}
                                                {% set allKeys = allKeys|merge([key]) %}
                                            {% endif %}
                                        {% endfor %}
                                        {% set allKeys = allKeys|sort %}
                                        
                                        {% for key in allKeys %}
                                            {% set oldValue = oldData[key] ?? null %}
                                            {% set newValue = newData[key] ?? null %}
                                            <tr class="{% if oldValue != newValue %}table-warning{% endif %}">
                                                <td class="fw-bold">
                                                    <i class="fas fa-tag me-1 text-muted small"></i>
                                                    {{ key|capitalize }}
                                                </td>
                                                <td>
                                                    {% if oldValue is null %}
                                                        <span class="text-muted">-</span>
                                                    {% elseif oldValue is iterable %}
                                                        <ul class="mb-0 ps-3">
                                                            {% for k, v in oldValue %}
                                                                <li><strong>{{ k }}:</strong> {{ v }}</li>
                                                            {% endfor %}
                                                        </ul>
                                                    {% else %}
                                                        {{ oldValue }}
                                                    {% endif %}
                                                </td>
                                                <td>
                                                    {% if newValue is null %}
                                                        <span class="text-muted">-</span>
                                                    {% elseif newValue is iterable %}
                                                        <ul class="mb-0 ps-3">
                                                            {% for k, v in newValue %}
                                                                <li><strong>{{ k }}:</strong> {{ v }}</li>
                                                            {% endfor %}
                                                        </ul>
                                                    {% else %}
                                                        {{ newValue }}
                                                    {% endif %}
                                                </td>
                                             </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        {% elseif oldData %}
                            <div class="alert alert-danger m-3">
                                <i class="fas fa-trash-alt me-2"></i>
                                <strong>Données supprimées :</strong>
                                <ul class="mt-2 mb-0">
                                    {% for key, value in oldData %}
                                        <li><strong>{{ key|capitalize }}:</strong> 
                                            {% if value is iterable %}
                                                <ul>
                                                    {% for k, v in value %}
                                                        <li>{{ k }}: {{ v }}</li>
                                                    {% endfor %}
                                                </ul>
                                            {% else %}
                                                {{ value }}
                                            {% endif %}
                                        </li>
                                    {% endfor %}
                                </ul>
                            </div>
                        {% elseif newData %}
                            <div class="alert alert-success m-3">
                                <i class="fas fa-plus-circle me-2"></i>
                                <strong>Données créées :</strong>
                                <ul class="mt-2 mb-0">
                                    {% for key, value in newData %}
                                        <li><strong>{{ key|capitalize }}:</strong> 
                                            {% if value is iterable %}
                                                <ul>
                                                    {% for k, v in value %}
                                                        <li>{{ k }}: {{ v }}</li>
                                                    {% endfor %}
                                                </ul>
                                            {% else %}
                                                {{ value }}
                                            {% endif %}
                                        </li>
                                    {% endfor %}
                                </ul>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
            {% endif %}
        </div>

        <div class="mt-4 pt-3 border-top">
            <a href="{{ path('app_audit_index') }}" class="btn-action btn-cancel text-decoration-none">
                <i class="fas fa-arrow-left me-1"></i> Retour à la liste
            </a>
        </div>
    </div>
</div>

<style>
.table-bordered td, .table-bordered th {
    vertical-align: top;
    padding: 12px;
}
.table-warning {
    background-color: #fff3cd !important;
}
</style>
{% endblock %}