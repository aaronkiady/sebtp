{% extends 'base.html.twig' %}

{% block title %}Nouveau paiement - {{ adherent.nom }}{% endblock %}

{% block body %}
<div class="main-wrapper">
    <div class="form-card-wide">
        <div class="card-header-modern">
            <div class="header-icon">
                <i class="fas fa-file-invoice-dollar"></i>
            </div>
            <div>
                <h4 class="mb-0 fw-800">Nouveau paiement</h4>
                <p class="text-muted mb-0 small">{{ adherent.nom }}</p>
            </div>
        </div>

        <div class="p-4 p-md-5">
            <div class="row mb-4">
                <div class="col-md-4">
                    <div class="alert alert-info mb-0">
                        <i class="fas fa-info-circle me-2"></i>
                        <strong>Montant attendu :</strong> {{ montantAttendu|number_format(0, '.', ' ') }} MGA
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="alert alert-warning mb-0">
                        <i class="fas fa-clock me-2"></i>
                        <strong>Reste à payer :</strong> {{ resteAPayer|number_format(0, '.', ' ') }} MGA
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="alert alert-secondary mb-0">
                        <i class="fas fa-tag me-2"></i>
                        <strong>Tarif appliqué :</strong>
                        {% if adherent.statutMenmbre == 'sponsor' %}
                            Membre sponsor
                        {% elseif adherent.type == 'ong' or 'ONG' in adherent.activite %}
                            Tarif ONG
                        {% else %}
                            Entreprise ({{ calculator.getTrancheEmployes(adherent.nbEmployes) }})
                        {% endif %}
                    </div>
                </div>
            </div>

            {{ form_start(form) }}
                <div class="row g-4">
                    <div class="col-md-6">
                        <label class="form-label">Période (Année) <span class="text-danger">*</span></label>
                        <select name="periode" id="periode_select" class="form-select custom-input" required>
                            {% set currentYear = "now"|date('Y') %}
                            <option value="{{ currentYear }}" {% if periode == currentYear %}selected{% endif %}>{{ currentYear }} (Année en cours)</option>
                            <option value="{{ currentYear + 1 }}" {% if periode == currentYear + 1 %}selected{% endif %}>{{ currentYear + 1 }} (Année prochaine)</option>
                            <option value="{{ currentYear - 1 }}" {% if periode == currentYear - 1 %}selected{% endif %}>{{ currentYear - 1 }}</option>
                            <option value="{{ currentYear - 2 }}" {% if periode == currentYear - 2 %}selected{% endif %}>{{ currentYear - 2 }}</option>
                            <option value="{{ currentYear - 3 }}" {% if periode == currentYear - 3 %}selected{% endif %}>{{ currentYear - 3 }}</option>
                            <option value="{{ currentYear - 4 }}" {% if periode == currentYear - 4 %}selected{% endif %}>{{ currentYear - 4 }}</option>
                            <option value="{{ currentYear - 5 }}" {% if periode == currentYear - 5 %}selected{% endif %}>{{ currentYear - 5 }}</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">{{ form.montant.vars.label }} <span class="text-danger">*</span></label>
                        {{ form_widget(form.montant, {'attr': {'class': 'form-control custom-input'}}) }}
                        <div class="text-danger small mt-1">{{ form_errors(form.montant) }}</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">{{ form.datePaiement.vars.label }} <span class="text-danger">*</span></label>
                        {{ form_widget(form.datePaiement, {'attr': {'class': 'form-control custom-input'}}) }}
                        <div class="text-danger small mt-1">{{ form_errors(form.datePaiement) }}</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">{{ form.modePaiement.vars.label }} <span class="text-danger">*</span></label>
                        {{ form_widget(form.modePaiement, {'attr': {'class': 'form-select custom-input'}}) }}
                        <div class="text-danger small mt-1">{{ form_errors(form.modePaiement) }}</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">{{ form.reference.vars.label }}</label>
                        {{ form_widget(form.reference, {'attr': {'class': 'form-control custom-input'}}) }}
                        <div class="text-danger small mt-1">{{ form_errors(form.reference) }}</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">{{ form.commentaire.vars.label }}</label>
                        {{ form_widget(form.commentaire, {'attr': {'class': 'form-control custom-input'}}) }}
                        <div class="text-danger small mt-1">{{ form_errors(form.commentaire) }}</div>
                    </div>
                    <div class="col-12">
                        <label class="form-label">{{ form.observation.vars.label }}</label>
                        {{ form_widget(form.observation, {'attr': {'class': 'form-control custom-input'}}) }}
                        <div class="text-danger small mt-1">{{ form_errors(form.observation) }}</div>
                    </div>
                </div>

                <div class="alert alert-info mt-3">
                    <i class="fas fa-info-circle me-2"></i>
                    <strong>Information :</strong> 
                    Vous êtes en train d'enregistrer un paiement pour l'année <strong>{{ periode }}</strong>.
                    {% if montantAttendu > 0 %}
                    Le montant attendu pour cette année est de <strong>{{ montantAttendu|number_format(0, '.', ' ') }} MGA</strong>.
                    {% endif %}
                </div>

                <div class="mt-5 pt-4 border-top d-flex justify-content-end gap-3">
                    <a href="{{ path('app_cotisation_history', {'adherent_id': adherent.id}) }}" class="btn-action btn-cancel text-decoration-none">
                        <i class="fas fa-times me-2"></i> Annuler
                    </a>
                    <button type="submit" class="btn-action btn-update">
                        <i class="fas fa-save me-2"></i> Enregistrer le paiement
                    </button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const periodeSelect = document.getElementById('periode_select');
    const anneeSpan = document.querySelector('.alert-info strong:first-of-type');
    const montantSpan = document.querySelector('.alert-info strong:last-of-type');
    
    if (periodeSelect) {
        periodeSelect.addEventListener('change', function() {
            const selectedPeriode = this.value;
            if (anneeSpan) {
                anneeSpan.textContent = selectedPeriode;
            }
            
            // Recharger la page avec la nouvelle période
            window.location.href = '{{ path('app_paiement_new', {'adherent_id': adherent.id}) }}?periode=' + selectedPeriode;
        });
    }
});
</script>
{% endblock %}