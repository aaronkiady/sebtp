{% extends 'base.html.twig' %}

{% block title %}Nouveau barème{% endblock %}

{% block body %}
<div class="main-wrapper mt-5">
    <div class="form-card-wide mx-auto my-4">
        <div class="card-header-modern">
            <div class="header-icon">
                <i class="fas fa-plus-circle"></i>
            </div>
            <div>
                <h4 class="mb-0 fw-800">Créer un nouveau barème</h4>
                <p class="text-muted mb-0 small">Définissez les montants de cotisation</p>
            </div>
        </div>

        <div class="p-4 p-md-5">
            <div class="alert alert-info mb-4">
                <i class="fas fa-info-circle me-2"></i>
                <strong>Information :</strong> Les nouveaux barèmes s'appliquent uniquement aux nouvelles cotisations.
                Les cotisations existantes conservent leur ancien montant.
            </div>

            {{ form_start(form) }}
                <div class="row g-4">
                    <div class="col-md-6">
                        <label class="form-label">{{ form.categorie.vars.label }}</label>
                        {{ form_widget(form.categorie, {'attr': {'class': 'form-select custom-input'}}) }}
                        <div class="text-danger small mt-1">{{ form_errors(form.categorie) }}</div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">{{ form.sousCategorie.vars.label }}</label>
                        {{ form_widget(form.sousCategorie, {'attr': {'class': 'form-select custom-input'}}) }}
                        <div class="text-danger small mt-1">{{ form_errors(form.sousCategorie) }}</div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">{{ form.montant.vars.label }}</label>
                        {{ form_widget(form.montant, {'attr': {'class': 'form-control custom-input'}}) }}
                        <div class="text-danger small mt-1">{{ form_errors(form.montant) }}</div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">{{ form.dateDebut.vars.label }}</label>
                        {{ form_widget(form.dateDebut, {'attr': {'class': 'form-control custom-input'}}) }}
                        <div class="text-danger small mt-1">{{ form_errors(form.dateDebut) }}</div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">{{ form.dateFin.vars.label }}</label>
                        {{ form_widget(form.dateFin, {'attr': {'class': 'form-control custom-input'}}) }}
                        <small class="text-muted">Laissez vide pour une durée indéterminée</small>
                        <div class="text-danger small mt-1">{{ form_errors(form.dateFin) }}</div>
                    </div>

                    <div class="col-12">
                        <label class="form-label">{{ form.description.vars.label }}</label>
                        {{ form_widget(form.description, {'attr': {'class': 'form-control custom-input'}}) }}
                        <div class="text-danger small mt-1">{{ form_errors(form.description) }}</div>
                    </div>
                </div>

                {{ form_rest(form) }}

                <div class="mt-5 pt-4 border-top d-flex justify-content-end gap-3">
                    <a href="{{ path('app_bareme_index') }}" class="btn-action btn-cancel text-decoration-none">
                        <i class="fas fa-times me-2"></i> Annuler
                    </a>
                    <button type="submit" class="btn-action btn-update">
                        <i class="fas fa-save me-2"></i> Créer le barème
                    </button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>

<style>
.custom-input:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 0.2rem rgba(79, 70, 229, 0.25);
}
</style>
{% endblock %}