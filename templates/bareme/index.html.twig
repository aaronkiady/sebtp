{% extends 'base.html.twig' %}

{% block title %}Gestion des barèmes{% endblock %}

{% block body %}
<div class="main-wrapper mt-5">
    <div class="form-card-wide p-4">
        <div class="d-flex justify-content-between align-items-start mb-4">
            <div class="d-flex align-items-center">
                <a href="{{ path('app_home') }}" class="btn btn-outline-secondary btn-sm shadow-sm me-3">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <div class="header-icon" style="background: var(--primary-light); color: var(--primary);">
                    <i class="fas fa-chart-line"></i>
                </div>
                <div>
                    <h1 class="h2 fw-bold text-dark mb-0">Gestion des barèmes</h1>
                    <p class="text-muted mb-0">Configuration des montants de cotisation</p>
                </div>
            </div>
            <div class="d-flex gap-2">
                <a href="{{ path('app_bareme_history') }}" class="btn btn-outline-info">
                    <i class="fas fa-history me-2"></i>Historique
                </a>
                <a href="{{ path('app_bareme_new') }}" class="btn btn-cute">
                    <i class="fas fa-plus me-2"></i>Nouveau barème
                </a>
            </div>
        </div>

        <div class="alert alert-info mb-4">
            <i class="fas fa-info-circle me-2"></i>
            <strong>Information :</strong> La modification d'un barème n'affecte pas les cotisations déjà générées. 
            Les nouveaux barèmes s'appliquent uniquement aux nouvelles cotisations.
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Catégorie</th>
                        <th>Tranche</th>
                        <th>Montant (MGA)</th>
                        <th>Date de début</th>
                        <th>Date de fin</th>
                        <th>Statut</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for bareme in baremes %}
                    <tr>
                        <td>
                            {% if bareme.categorie == 'entreprise' %}
                                <span class="badge bg-primary">Entreprise</span>
                            {% elseif bareme.categorie == 'ong' %}
                                <span class="badge bg-success">ONG / Association</span>
                            {% else %}
                                <span class="badge bg-warning">Sponsor</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if bareme.sousCategorie == '1-10' %}
                                1 à 10 employés
                            {% elseif bareme.sousCategorie == '11-50' %}
                                11 à 50 employés
                            {% elseif bareme.sousCategorie == '51+' %}
                                Plus de 50 employés
                            {% else %}
                                <span class="text-muted">-</span>
                            {% endif %}
                        </td>
                        <td class="fw-bold text-primary">{{ bareme.montant|number_format(0, '.', ' ') }} MGA</td>
                        <td>{{ bareme.dateDebut|date('d/m/Y') }}</td>
                        <td>{{ bareme.dateFin ? bareme.dateFin|date('d/m/Y') : '-' }}</td>
                        <td>
                            {% if bareme.actif %}
                                <span class="badge bg-success">Actif</span>
                            {% else %}
                                <span class="badge bg-secondary">Inactif</span>
                            {% endif %}
                        </td>
                        <td class="text-end">
                            <div class="btn-group">
                                <a href="{{ path('app_bareme_edit', {'id': bareme.id}) }}" 
                                   class="btn btn-sm btn-outline-secondary border-0 bg-light" 
                                   title="Modifier">
                                    <i class="fas fa-edit"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="text-center py-5">
                            <div class="mb-3">
                                <i class="fas fa-chart-line fa-4x text-muted opacity-25"></i>
                            </div>
                            <p class="text-muted fw-bold">Aucun barème configuré.</p>
                            <a href="{{ path('app_bareme_new') }}" class="btn btn-primary mt-2">
                                <i class="fas fa-plus me-2"></i>Ajouter un barème
                            </a>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        {# Récapitulatif des montants actuels #}
        <div class="card shadow-sm mt-4">
            <div class="card-header bg-white fw-bold">
                <i class="fas fa-calculator me-2 text-primary"></i>Récapitulatif des barèmes actifs
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4">
                        <div class="card border">
                            <div class="card-body text-center">
                                <h6 class="fw-bold">Entreprise</h6>
                                {% for item in baremes %}
                                    {% if item.categorie == 'entreprise' %}
                                        <div class="d-flex justify-content-between small mb-1">
                                            <span>
                                                {% if item.sousCategorie == '1-10' %}
                                                    1-10 employés
                                                {% elseif item.sousCategorie == '11-50' %}
                                                    11-50 employés
                                                {% elseif item.sousCategorie == '51+' %}
                                                    51+ employés
                                                {% endif %}
                                            </span>
                                            <strong>{{ item.montant|number_format(0, '.', ' ') }} MGA</strong>
                                        </div>
                                    {% endif %}
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card border">
                            <div class="card-body text-center">
                                <h6 class="fw-bold">ONG / Association</h6>
                                {% for item in baremes %}
                                    {% if item.categorie == 'ong' %}
                                        <div class="mt-2">
                                            <strong>{{ item.montant|number_format(0, '.', ' ') }} MGA</strong>
                                        </div>
                                    {% endif %}
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card border">
                            <div class="card-body text-center">
                                <h6 class="fw-bold">Sponsor</h6>
                                {% for item in baremes %}
                                    {% if item.categorie == 'sponsor' %}
                                        <div class="mt-2">
                                            <strong>{{ item.montant|number_format(0, '.', ' ') }} MGA</strong>
                                        </div>
                                    {% endif %}
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}