{% extends 'base.html.twig' %}

{% block title %}Modifier le barème{% endblock %}

{% block body %}
<div class="main-wrapper mt-5">
    <div class="form-card-wide mx-auto my-4">
        <div class="card-header-modern">
            <div class="header-icon">
                <i class="fas fa-edit"></i>
            </div>
            <div>
                <h4 class="mb-0 fw-800">Modifier le barème</h4>
                <p class="text-muted mb-0 small">Modifiez les montants de cotisation</p>
            </div>
        </div>

        <div class="p-4 p-md-5">
            <div class="alert alert-warning mb-4">
                <i class="fas fa-exclamation-triangle me-2"></i>
                <strong>Attention :</strong> La modification de ce barème n'affectera pas les cotisations déjà générées.
                Les nouvelles cotisations utiliseront ce nouveau montant.
            </div>

            {{ form_start(form) }}
                <div class="row g-4">
                    <div class="col-md-6">
                        <label class="form-label">{{ form.categorie.vars.label }}</label>
                        {{ form_widget(form.categorie, {'attr': {'class': 'form-select custom-input'}}) }}
                        <div class="text-danger small mt-1">{{ form_errors(form.categorie) }}</div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">{{ form.sousCategorie.vars.label }}</label>
                        {{ form_widget(form.sousCategorie, {'attr': {'class': 'form-select custom-input'}}) }}
                        <div class="text-danger small mt-1">{{ form_errors(form.sousCategorie) }}</div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">{{ form.montant.vars.label }}</label>
                        {{ form_widget(form.montant, {'attr': {'class': 'form-control custom-input'}}) }}
                        <div class="text-danger small mt-1">{{ form_errors(form.montant) }}</div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">{{ form.dateDebut.vars.label }}</label>
                        {{ form_widget(form.dateDebut, {'attr': {'class': 'form-control custom-input'}}) }}
                        <div class="text-danger small mt-1">{{ form_errors(form.dateDebut) }}</div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">{{ form.dateFin.vars.label }}</label>
                        {{ form_widget(form.dateFin, {'attr': {'class': 'form-control custom-input'}}) }}
                        <div class="text-danger small mt-1">{{ form_errors(form.dateFin) }}</div>
                    </div>

                    <div class="col-12">
                        <label class="form-label">{{ form.description.vars.label }}</label>
                        {{ form_widget(form.description, {'attr': {'class': 'form-control custom-input'}}) }}
                        <div class="text-danger small mt-1">{{ form_errors(form.description) }}</div>
                    </div>
                </div>

                {{ form_rest(form) }}

                <div class="mt-5 pt-4 border-top d-flex justify-content-end gap-3">
                    <a href="{{ path('app_bareme_index') }}" class="btn-action btn-cancel text-decoration-none">
                        <i class="fas fa-times me-2"></i> Annuler
                    </a>
                    <button type="submit" class="btn-action btn-update">
                        <i class="fas fa-save me-2"></i> Enregistrer les modifications
                    </button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>

    {# Information sur l'historique du barème #}
    <div class="form-card-wide mx-auto my-4">
        <div class="card-header-modern">
            <div class="header-icon">
                <i class="fas fa-history"></i>
            </div>
            <div>
                <h4 class="mb-0 fw-800">Informations</h4>
                <p class="text-muted mb-0 small">Détails du barème</p>
            </div>
        </div>
        <div class="p-4">
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-2">
                        <strong>Catégorie :</strong>
                        {% if bareme.categorie == 'entreprise' %}
                            <span class="badge bg-primary">Entreprise</span>
                        {% elseif bareme.categorie == 'ong' %}
                            <span class="badge bg-success">ONG / Association</span>
                        {% else %}
                            <span class="badge bg-warning">Sponsor</span>
                        {% endif %}
                    </div>
                    <div class="mb-2">
                        <strong>Tranche :</strong>
                        {% if bareme.sousCategorie == '1-10' %}
                            1 à 10 employés
                        {% elseif bareme.sousCategorie == '11-50' %}
                            11 à 50 employés
                        {% elseif bareme.sousCategorie == '51+' %}
                            Plus de 50 employés
                        {% else %}
                            <span class="text-muted">Non applicable</span>
                        {% endif %}
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-2">
                        <strong>Montant actuel :</strong>
                        <span class="fw-bold text-primary">{{ bareme.montant|number_format(0, '.', ' ') }} MGA</span>
                    </div>
                    <div class="mb-2">
                        <strong>Date de création :</strong>
                        {{ bareme.createdAt|date('d/m/Y H:i') }}
                    </div>
                    {% if bareme.createdBy %}
                        <div class="mb-2">
                            <strong>Créé par :</strong>
                            {{ bareme.createdBy }}
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.custom-input:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 0.2rem rgba(79, 70, 229, 0.25);
}
</style>
{% endblock %}