{% extends 'base.html.twig' %}

{% block title %}Historique Cotisations - {{ adherent.nom }}{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800">Historique Financier</h1>
            <p class="text-muted">Suivi des cotisations pour <strong>{{ adherent.nom }}</strong></p>
        </div>
        <a href="{{ path('app_liste_show', {'id': adherent.id}) }}" class="btn btn-outline-secondary shadow-sm">
            <i class="fas fa-arrow-left"></i> Retour à la fiche
        </a>
    </div>

    {# Accordéon des cotisations par période #}
    <div class="accordion" id="accordionCotisations">
        {% for cotisation in cotisations %}
        <div class="accordion-item mb-3 border rounded shadow-sm">
            <h2 class="accordion-header" id="heading{{ cotisation.id }}">
                <button class="accordion-button {{ loop.index != 1 ? 'collapsed' : '' }}" type="button" 
                        data-bs-toggle="collapse" data-bs-target="#collapse{{ cotisation.id }}" 
                        aria-expanded="{{ loop.index == 1 ? 'true' : 'false' }}" 
                        aria-controls="collapse{{ cotisation.id }}">
                    <div class="d-flex justify-content-between w-100 me-3">
                        <strong class="text-primary">Année {{ cotisation.periode }}</strong>
                        <div class="d-flex gap-3">
                            <span class="text-success">Payé: {{ cotisation.montantPaye|number_format(0, '.', ' ') }} MGA</span>
                            <span class="text-danger">Reste: {{ cotisation.getResteAPayer|number_format(0, '.', ' ') }} MGA</span>
                            {% if cotisation.statut == 'paye' %}
                                <span class="badge bg-success">Payé</span>
                            {% elseif cotisation.statut == 'partiel' %}
                                <span class="badge bg-warning">Partiel</span>
                            {% else %}
                                <span class="badge bg-danger">Impayé</span>
                            {% endif %}
                        </div>
                    </div>
                </button>
            </h2>
            <div id="collapse{{ cotisation.id }}" class="accordion-collapse collapse {{ loop.index == 1 ? 'show' : '' }}" 
                 aria-labelledby="heading{{ cotisation.id }}" data-bs-parent="#accordionCotisations">
                <div class="accordion-body">
                    <div class="row mb-4">
                        <div class="col-md-4">
                            <div class="card bg-light">
                                <div class="card-body text-center">
                                    <div class="text-muted small">Montant attendu</div>
                                    <h4 class="mb-0">{{ cotisation.montant|number_format(0, '.', ' ') }} MGA</h4>
                                    <small class="text-muted">
                                        {% if adherent.statutMenmbre == 'sponsor' %}
                                            Membre sponsor
                                        {% elseif adherent.type == 'ong' or 'ONG' in adherent.activite %}
                                            Tarif ONG
                                        {% else %}
                                            {{ calculator.getTrancheEmployes(adherent.nbEmployes) }}
                                        {% endif %}
                                    </small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-8">
                            {% set paiements = cotisation.paiements %}
                            {% if paiements|length > 0 %}
                            <h6 class="fw-bold mb-2">Historique des paiements</h6>
                            <div class="table-responsive">
                                <table class="table table-sm">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Date</th>
                                            <th>Montant</th>
                                            <th>Mode</th>
                                            <th>Référence</th>
                                            <th class="text-center">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for paiement in paiements %}
                                        <tr>
                                            <td>{{ paiement.datePaiement|date('d/m/Y') }}</td>
                                            <td class="text-success fw-bold">{{ paiement.montant|number_format(0, '.', ' ') }} MGA</td>
                                            <td>{{ paiement.modePaiement|default('-') }}</td>
                                            <td>{{ paiement.reference|default('-') }}</td>
                                            {# Dans la liste des paiements, ajoutez une colonne action #}
                                            <td class="text-center">
                                                <div class="btn-group">
                                                    <a href="{{ path('app_document_generer_recu', {'cotisation_id': cotisation.id}) }}" 
                                                    class="btn btn-sm btn-success" title="Générer le reçu">
                                                        <i class="fas fa-file-pdf"></i>
                                                    </a>
                                                    <a href="{{ path('app_paiement_edit', {'id': paiement.id}) }}" 
                                                    class="btn btn-sm btn-outline-warning" title="Modifier">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    <form method="post" action="{{ path('app_paiement_delete', {'id': paiement.id}) }}" 
                                                        onsubmit="return confirm('Supprimer ce paiement ?')" style="display:inline">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_paiement_' ~ paiement.id) }}">
                                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Supprimer">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </table>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                            {% else %}
                            <div class="alert alert-light text-center">
                                <i class="fas fa-info-circle me-1"></i> 
                                Aucun paiement pour l'année {{ cotisation.periode }}
                            </div>
                            {% endif %}
                            <div class="text-end mt-2">
                                <a href="{{ path('app_paiement_new', {'adherent_id': adherent.id, 'periode': cotisation.periode}) }}" class="btn btn-sm btn-primary">
                                    <i class="fas fa-plus me-1"></i> Ajouter un paiement pour {{ cotisation.periode }}
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {% else %}
        <div class="card shadow mb-4">
            <div class="card-body text-center py-5">
                <i class="fas fa-folder-open fa-3x mb-3 d-block opacity-25"></i>
                <p class="text-muted fw-bold">Aucune cotisation trouvée.</p>
                <a href="{{ path('app_cotisation_generate', {'adherent_id': adherent.id}) }}" class="btn btn-sm btn-info">
                    <i class="fas fa-plus me-1"></i> Générer la cotisation {{ "now"|date('Y') }}
                </a>
            </div>
        </div>
        {% endfor %}
    </div>

    <div class="text-center mt-3">
        <a href="{{ path('app_paiement_new', {'adherent_id': adherent.id}) }}" class="btn btn-primary">
            <i class="fas fa-plus me-2"></i> Enregistrer un paiement
        </a>
    </div>
</div>
{% endblock %}