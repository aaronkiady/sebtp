{% extends 'base.html.twig' %}

{% block title %}Historique Cotisations - {{ adherent.nom }}{% endblock %}

{% block body %}
<div class="container mt-5">
    {# En-tête avec navigation #}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800">Historique Financier</h1>
            <p class="text-muted">Suivi des cotisations pour <strong>{{ adherent.nom }}</strong></p>
        </div>
        <a href="{{ path('app_liste_show', {'id': adherent.id}) }}" class="btn btn-outline-secondary shadow-sm">
            <i class="fas fa-arrow-left"></i> Retour à la fiche
        </a>
    </div>

    {# Statistiques rapides #}
    <div class="row mb-4">
        {# Total Versé #}
        <div class="col-md-4 mb-3">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Total encaissé</div>
                            {% set totalEncasse = 0 %}
                            {% for c in cotisations %}{% if c.statut == 'payé' %}{% set totalEncasse = totalEncasse + c.montant %}{% endif %}{% endfor %}
                            <div class="h5 mb-0 font-weight-bold text-gray-800">{{ totalEncasse|number_format(0, '.', ' ') }} MGA</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-money-bill-wave fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# Statut Année en Cours #}
        <div class="col-md-4 mb-3">
            <div class="card border-left-{{ adherent.isAjour ? 'primary' : 'danger' }} shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-{{ adherent.isAjour ? 'primary' : 'danger' }} text-uppercase mb-1">Statut {{ "now"|date("Y") }}</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">
                                {{ adherent.isAjour ? 'À JOUR' : 'IMPAYÉ' }}
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas {{ adherent.isAjour ? 'fa-check-circle text-primary' : 'fa-exclamation-triangle text-danger' }} fa-2x"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Tableau des Cotisations #}
    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center bg-white">
            <h6 class="m-0 font-weight-bold text-primary">Détails des règlements</h6>
            <a href="{{ path('app_cotisation_new', {'adherent_id': adherent.id}) }}" class="btn btn-sm btn-primary shadow-sm">
                <i class="fas fa-plus"></i> Enregistrer un paiement
            </a>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover" width="100%" cellspacing="0">
                    <thead class="table-light">
                        <tr>
                            <th>Période</th>
                            <th>Montant</th>
                            <th>Date de paiement</th>
                            <th>Mode & Réf</th>
                            <th class="text-center">Statut</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for cotisation in cotisations %}
                        <tr>
                            <td class="align-middle">
                                <span class="badge bg-light text-dark border px-3 py-2">{{ cotisation.periode }}</span>
                            </td>
                            <td class="align-middle fw-bold">
                                {{ cotisation.montant|number_format(0, '.', ' ') }} MGA
                            </td>
                            <td class="align-middle">
                                {{ cotisation.datePaiement ? cotisation.datePaiement|date('d/m/Y') : '-' }}
                            </td>
                            <td class="align-middle text-muted small">
                                <i class="fas fa-credit-card"></i> {{ cotisation.modePaiement }}<br>
                                <span class="text-xs">Ref: {{ cotisation.reference|default('N/A') }}</span>
                            </td>
                            <td class="align-middle text-center">
                                {% if cotisation.statut == 'payé' %}
                                    <span class="badge rounded-pill bg-success-soft text-success border border-success">
                                        <i class="fas fa-check"></i> PAYÉ
                                    </span>
                                {% else %}
                                    <span class="badge rounded-pill bg-danger-soft text-danger border border-danger">
                                        <i class="fas fa-clock"></i> EN ATTENTE
                                    </span>
                                {% endif %}
                            </td>
                            <td class="align-middle text-center">
                                <div class="btn-group">
                                    <a href="{{ path('app_cotisation_edit', {'id': cotisation.id}) }}" class="btn btn-sm btn-outline-warning" title="Modifier">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="fas fa-folder-open fa-3x mb-3 d-block opacity-25"></i>
                                Aucune cotisation trouvée pour cet adhérent.
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .border-left-primary { border-left: 0.25rem solid #4e73df !important; }
        .border-left-success { border-left: 0.25rem solid #1cc88a !important; }
        .border-left-danger { border-left: 0.25rem solid #e74a3b !important; }
        
        .bg-success-soft { background-color: #eafaf1; }
        .bg-danger-soft { background-color: #fdedec; }
        
        .text-xs { font-size: .75rem; text-transform: uppercase; }
        .table-hover tbody tr:hover { background-color: rgba(0,0,0,.02); }
        .badge { font-weight: 600; }
    </style>
{% endblock %}