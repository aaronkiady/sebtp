{% extends 'base.html.twig' %}

{% block title %}Gestion des Cotisations{% endblock %}

{% block body %}
<div class="container mt-3">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

        {# Bouton retour #}
        <a href="{{ path('app_home') }}" class="btn btn-outline-secondary shadow-sm">
            <i class="fas fa-arrow-left me-2"></i>
            Retour au dashboard
        </a>

        {# Actions #}
        <div class="d-flex gap-2">
            <a href="{{ path('app_cotisation_import') }}" class="btn btn-outline-primary">
                <i class="fas fa-file-excel me-2"></i>
                Importer Excel
            </a>

            <a href="{{ path('app_export_cotisations_form') }}" class="btn btn-outline-success">
                <i class="fas fa-file-excel me-2"></i>
                Exporter
            </a>
        </div>

    </div>
</div>

<div class="main-wrapper mt-3">
    <div class="form-card-wide p-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h2 fw-bold text-dark">Cotisations</h1>
                <p class="text-muted">Flux financier et suivi des paiements</p>
            </div>
        </div>

        {# Barre de recherche #}
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <form method="get" action="{{ path('app_cotisation_index') }}" class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Rechercher un adhérent</label>
                        <input type="text" name="search" class="form-control" placeholder="Nom, email ou téléphone..." value="{{ search }}">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Statut adhérent</label>
                        <select name="statutAdherent" class="form-select">
                            <option value="">Tous</option>
                            <option value="actif" {% if statutAdherentFilter == 'actif' %}selected{% endif %}>Actif</option>
                            <option value="inactif" {% if statutAdherentFilter == 'inactif' %}selected{% endif %}>Inactif</option>
                            <option value="radie" {% if statutAdherentFilter == 'radie' %}selected{% endif %}>Radié</option>
                            <option value="demande" {% if statutAdherentFilter == 'demande' %}selected{% endif %}>Demande</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Statut paiement</label>
                        <select name="statut" class="form-select">
                            <option value="">Tous</option>
                            <option value="paye" {% if statutFilter == 'paye' %}selected{% endif %}>Payé</option>
                            <option value="partiel" {% if statutFilter == 'partiel' %}selected{% endif %}>Partiel</option>
                            <option value="impaye" {% if statutFilter == 'impaye' %}selected{% endif %}>Impayé</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Année</label>
                        <select name="periode" class="form-select">
                            <option value="">Toutes</option>
                            {% set currentYear = "now"|date('Y') %}
                            <option value="{{ currentYear }}" {% if periodeFilter == currentYear %}selected{% endif %}>{{ currentYear }}</option>
                            <option value="{{ currentYear - 1 }}" {% if periodeFilter == currentYear - 1 %}selected{% endif %}>{{ currentYear - 1 }}</option>
                            <option value="{{ currentYear - 2 }}" {% if periodeFilter == currentYear - 2 %}selected{% endif %}>{{ currentYear - 2 }}</option>
                        </select>
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="fas fa-search me-2"></i>Rechercher
                        </button>
                    </div>
                </form>
            </div>
        </div>

        {# TOTAUX 
        {% set totalAttendu = 0 %}
        {% set totalPaye = 0 %}
        {% set totalReste = 0 %}
        {% for cotisation in cotisations %}
            {% set totalAttendu = totalAttendu + cotisation.montant %}
            {% set totalPaye = totalPaye + cotisation.montantPaye %}
            {% set totalReste = totalReste + cotisation.getResteAPayer %}
        {% endfor %}

        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm" style="background: linear-gradient(135deg, #f0f7ee 0%, #e6f0e6 100%);">
                    <div class="card-body text-center">
                        <small class="text-muted text-uppercase fw-bold">Montant total attendu</small>
                        <h3 class="fw-bold text-success mb-0">{{ totalAttendu|number_format(0, '.', ' ') }} MGA</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm" style="background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);">
                    <div class="card-body text-center">
                        <small class="text-muted text-uppercase fw-bold">Montant total payé</small>
                        <h3 class="fw-bold text-primary mb-0">{{ totalPaye|number_format(0, '.', ' ') }} MGA</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm" style="background: linear-gradient(135deg, #fff3e0 0%, #ffe0b2 100%);">
                    <div class="card-body text-center">
                        <small class="text-muted text-uppercase fw-bold">Reste à payer total</small>
                        <h3 class="fw-bold text-warning mb-0">{{ totalReste|number_format(0, '.', ' ') }} MGA</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm" style="background: linear-gradient(135deg, #f3e5f5 0%, #e1bee7 100%);">
                    <div class="card-body text-center">
                        <small class="text-muted text-uppercase fw-bold">Nombre de cotisations</small>
                        <h3 class="fw-bold text-purple mb-0">{{ cotisations|length }}</h3>
                    </div>
                </div>
            </div>
        </div>#}

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Adhérent</th>
                        <th>Période</th>
                        <th>Montant attendu</th>
                        <th>Montant payé</th>
                        <th>Reste à payer</th>
                        <th>Statut paiement</th>
                        <th>Statut adhérent</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for cotisation in cotisations %}
                    {% set adherent = cotisation.adherent %}
                    {% set paye = cotisation.montantPaye %}
                    {% set reste = cotisation.getResteAPayer %}
                    {% set montantAttendu = cotisation.montant %}
                    <tr>
                        <td class="fw-bold">
                            <i class="fas fa-building me-2 text-primary opacity-50"></i>
                            {{ adherent.nom }}
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">{{ cotisation.periode }}</span>
                        </td>
                        <td class="fw-bold">{{ montantAttendu|number_format(0, '.', ' ') }} MGA</td>
                        <td class="text-success fw-bold">{{ paye|number_format(0, '.', ' ') }} MGA</td>
                        <td class="{% if reste > 0 %}text-danger{% else %}text-success{% endif %} fw-bold">
                            {{ reste|number_format(0, '.', ' ') }} MGA
                        </td>
                        <td>
                            {% if cotisation.statut == 'paye' %}
                                <span class="badge bg-success rounded-pill">Payé</span>
                            {% elseif cotisation.statut == 'partiel' %}
                                <span class="badge bg-warning rounded-pill">Partiel</span>
                            {% else %}
                                <span class="badge bg-danger rounded-pill">Impayé</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if adherent.statut == 'actif' %}
                                <span class="badge bg-success rounded-pill">Actif</span>
                            {% elseif adherent.statut == 'inactif' %}
                                <span class="badge bg-secondary rounded-pill">Inactif</span>
                            {% elseif adherent.statut == 'radie' %}
                                <span class="badge bg-danger rounded-pill">Radié</span>
                            {% elseif adherent.statut == 'demande' %}
                                <span class="badge bg-warning rounded-pill">Demande</span>
                            {% else %}
                                <span class="badge bg-light text-dark rounded-pill">-</span>
                            {% endif %}
                        </td>
                        <td class="text-end">
                            <a href="{{ path('app_cotisation_history', {'adherent_id': adherent.id}) }}" class="btn btn-sm btn-primary">
                                <i class="fas fa-eye me-1"></i> Voir
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="8" class="text-center py-5">
                            <div class="mb-3">
                                <i class="fas fa-wallet fa-3x opacity-25 text-muted"></i>
                            </div>
                            <p class="text-muted fw-bold">Aucune cotisation trouvée.</p>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        {# Affichage du nombre de résultats #}
        <div class="mt-3 text-muted small">
            <i class="fas fa-list me-1"></i> {{ cotisations|length }} cotisation(s) trouvée(s)
        </div>
    </div>
</div>
{% endblock %}