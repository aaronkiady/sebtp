{% extends 'base.html.twig' %}

{% block title %}Détail Cotisation - {{ cotisation.adherent.nom }}{% endblock %}

{% block body %}
<div class="main-wrapper mt-5">
    <div class="form-card-wide p-4">
        <div class="d-flex justify-content-between align-items-start mb-4">
            <div class="d-flex align-items-center">
                <a href="{{ path('app_cotisation_history', {'adherent_id': cotisation.adherent.id}) }}" class="btn btn-outline-secondary btn-sm shadow-sm me-3">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <div class="header-icon" style="background: var(--primary-light); color: var(--primary);">
                    <i class="fas fa-file-invoice-dollar"></i>
                </div>
                <div>
                    <h1 class="h2 fw-bold text-dark mb-0">Détail cotisation</h1>
                    <p class="text-muted mb-0">{{ cotisation.adherent.nom }} - {{ cotisation.periode }}</p>
                </div>
            </div>
            <div class="d-flex gap-2">
                <a href="{{ path('app_paiement_new', {'adherent_id': cotisation.adherent.id}) }}" class="btn btn-cute btn-sm">
                    <i class="fas fa-plus me-1"></i> Ajouter un paiement
                </a>
            </div>
        </div>

        <div class="row g-4">
            {# Informations générales #}
            <div class="col-md-6">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h6 class="card-title text-muted mb-3">
                            <i class="fas fa-info-circle me-2"></i>Informations générales
                        </h6>
                        <div class="mb-3">
                            <label class="text-muted small">Adhérent</label>
                            <div class="fw-bold">
                                <i class="fas fa-building me-2 text-primary"></i>
                                <a href="{{ path('app_liste_show', {'id': cotisation.adherent.id}) }}" class="text-decoration-none">
                                    {{ cotisation.adherent.nom }}
                                </a>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="text-muted small">Période</label>
                            <div class="fw-bold">
                                <i class="fas fa-calendar me-2 text-primary"></i>
                                {{ cotisation.periode }}
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="text-muted small">Montant attendu</label>
                            <div class="fw-bold text-primary">
                                <i class="fas fa-money-bill-wave me-2"></i>
                                {{ cotisation.montant|number_format(0, '.', ' ') }} MGA
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {# Statistiques de paiement #}
            <div class="col-md-6">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h6 class="card-title text-muted mb-3">
                            <i class="fas fa-chart-line me-2"></i>Statut du paiement
                        </h6>
                        <div class="mb-3">
                            <label class="text-muted small">Montant payé</label>
                            <div class="fw-bold text-success">
                                <i class="fas fa-check-circle me-2"></i>
                                {{ cotisation.montantPaye|number_format(0, '.', ' ') }} MGA
                            </div>
                            <div class="progress mt-2" style="height: 10px;">
                                {% set pourcentage = (cotisation.montantPaye / cotisation.montant) * 100 %}
                                <div class="progress-bar bg-success" style="width: {{ pourcentage }}%"></div>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="text-muted small">Reste à payer</label>
                            <div class="fw-bold text-danger">
                                <i class="fas fa-clock me-2"></i>
                                {{ cotisation.getResteAPayer|number_format(0, '.', ' ') }} MGA
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="text-muted small">Statut</label>
                            <div>
                                {% if cotisation.statut == 'paye' %}
                                    <span class="badge bg-success rounded-pill px-3 py-2">
                                        <i class="fas fa-check-circle me-1"></i> PAYÉ
                                    </span>
                                {% elseif cotisation.statut == 'partiel' %}
                                    <span class="badge bg-warning rounded-pill px-3 py-2">
                                        <i class="fas fa-clock me-1"></i> PARTIEL
                                    </span>
                                {% else %}
                                    <span class="badge bg-danger rounded-pill px-3 py-2">
                                        <i class="fas fa-times-circle me-1"></i> IMPAYÉ
                                    </span>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {# Liste des paiements #}
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-header bg-white">
                        <h6 class="mb-0">
                            <i class="fas fa-list me-2"></i>Historique des paiements
                        </h6>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Date</th>
                                        <th>Montant</th>
                                        <th>Mode de paiement</th>
                                        <th>Référence</th>
                                        <th>Observation</th>
                                        <th class="text-center">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                {% for paiement in cotisation.paiements %}
                                    <tr>
                                        <td>{{ paiement.datePaiement|date('d/m/Y') }}</td>
                                        <td class="fw-bold text-success">{{ paiement.montant|number_format(0, '.', ' ') }} MGA</td>
                                        <td>{{ paiement.modePaiement|default('-') }}</td>
                                        <td>{{ paiement.reference|default('-') }}</td>
                                        <td>{{ paiement.commentaire|default('-') }}</td>
                                        <td>{{ paiement.observation|default('-') }}</td>
                                        <td class="text-center">
                                            <div class="btn-group">
                                                <a href="{{ path('app_paiement_edit', {'id': paiement.id}) }}" 
                                                   class="btn btn-sm btn-outline-warning" title="Modifier">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <form method="post" 
                                                      action="{{ path('app_paiement_delete', {'id': paiement.id}) }}" 
                                                      onsubmit="return confirm('Supprimer ce paiement ?')" 
                                                      style="display:inline">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_paiement_' ~ paiement.id) }}">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Supprimer">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="6" class="text-center py-4">
                                            <i class="fas fa-wallet fa-2x text-muted opacity-25 mb-2"></i>
                                            <p class="text-muted mb-0">Aucun paiement enregistré</p>
                                            <a href="{{ path('app_paiement_new', {'adherent_id': cotisation.adherent.id}) }}" class="btn btn-sm btn-primary mt-2">
                                                <i class="fas fa-plus me-1"></i> Ajouter un paiement
                                            </a>
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-4 pt-3 border-top">
            <a href="{{ path('app_cotisation_history', {'adherent_id': cotisation.adherent.id}) }}" class="text-muted text-decoration-none small">
                <i class="fas fa-chevron-left me-1"></i> Retour à l'historique
            </a>
        </div>
    </div>
</div>
{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .progress-bar {
        transition: width 0.5s ease;
    }
</style>
{% endblock %}