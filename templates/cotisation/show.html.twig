{% extends 'base.html.twig' %}

{% block title %}Cotisation{% endblock %}

{% block body %}
    <h1>Cotisation</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ cotisation.id }}</td>
            </tr>
            <tr>
                <th>Montant</th>
                <td>{{ cotisation.montant }}</td>
            </tr>
            <tr>
                <th>DatePaiement</th>
                <td>{{ cotisation.datePaiement ? cotisation.datePaiement|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>ModePaiement</th>
                <td>{{ cotisation.modePaiement }}</td>
            </tr>
            <tr>
                <th>Reference</th>
                <td>{{ cotisation.reference }}</td>
            </tr>
            <tr>
                <th>Statut</th>
                <td>{{ cotisation.statut }}</td>
            </tr>
            <tr>
                <th>Periode</th>
                <td>{{ cotisation.periode }}</td>
            </tr>
            <tr>
                <th>Observation</th>
                <td>{{ cotisation.observation }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_cotisation_index') }}">back to list</a>

    <a href="{{ path('app_cotisation_edit', {'id': cotisation.id}) }}">edit</a>

    {{ include('cotisation/_delete_form.html.twig') }}
{% endblock %}
