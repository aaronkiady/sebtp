{% extends 'base.html.twig' %}

{% block body %}
<div class="main-wrapper">
    <div class="form-card-wide">
        <div class="card-header-modern">
            <div class="header-icon">
                <i class="fas fa-file-invoice-dollar"></i>
            </div>
            <div>
                <h4 class="mb-0 fw-800">Modifier le Paiement</h4>
                <p class="text-muted mb-0 small">Ajustez les détails de la transaction</p>
            </div>
        </div>

        <div class="p-4 p-md-5">
            {{ form_start(form) }}
                <div class="row g-4">
                    {% for field in form %}
                        {% if field.vars.name != '_token' %}
                            <div class="col-md-6">
                                <label class="form-label">
                                    {{ field.vars.label|default(field.vars.name|capitalize) }}
                                </label>
                                {{ form_widget(field, {'attr': {'class': 'form-control custom-input'}}) }}
                            </div>
                        {% endif %}
                    {% endfor %}
                </div>

                <div class="mt-5 pt-4 border-top d-flex justify-content-end gap-3">
                    <a href="{{ path('app_cotisation_index') }}" class="btn-action btn-cancel text-decoration-none">
                        Annuler
                    </a>
                    <button type="submit" class="btn-action btn-update">
                        <i class="fas fa-sync-alt"></i> Mettre à jour
                    </button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}