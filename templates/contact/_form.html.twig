{{ form_start(form) }}
    <div class="row g-4">
        <div class="col-md-6">
            <label class="form-label">
                <i class="fas fa-user-tie me-2 opacity-50"></i>{{ form_label(form.nom) }}
            </label>
            {{ form_widget(form.nom, {'attr': {'class': 'form-control custom-input'}}) }}
            <div class="text-danger small">{{ form_errors(form.nom) }}</div>
        </div>

        <div class="col-md-6">
            <label class="form-label">
                <i class="fas fa-id-badge me-2 opacity-50"></i>{{ form_label(form.fonction) }}
            </label>
            {{ form_widget(form.fonction, {'attr': {'class': 'form-control custom-input'}}) }}
            <div class="text-danger small">{{ form_errors(form.fonction) }}</div>
        </div>

        <div class="col-md-6">
            <label class="form-label">
                <i class="fas fa-envelope me-2 opacity-50"></i>{{ form_label(form.email) }}
            </label>
            {{ form_widget(form.email, {'attr': {'class': 'form-control custom-input'}}) }}
            <div class="text-danger small">{{ form_errors(form.email) }}</div>
        </div>

        <div class="col-md-6">
            <label class="form-label">
                <i class="fas fa-phone-alt me-2 opacity-50"></i>{{ form_label(form.telephone) }}
            </label>
            {{ form_widget(form.telephone, {'attr': {'class': 'form-control custom-input'}}) }}
            <div class="text-danger small">{{ form_errors(form.telephone) }}</div>
        </div>
    </div>

    <div class="mt-5 pt-4 border-top d-flex justify-content-end gap-3">
        <button type="submit" class="btn-action btn-update">
            <i class="fas fa-save me-2"></i> {{ button_label|default('Enregistrer le contact') }}
        </button>
    </div>
{{ form_end(form) }}