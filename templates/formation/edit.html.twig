{% extends 'base.html.twig' %}

{% block title %}Modifier Formation{% endblock %}

{% block body %}
<div class="main-wrapper">
    <div class="form-card-wide" style="max-width: 800px;">
        <div class="card-header-modern">
            <div class="header-icon" style="background: #fff7ed; color: #ea580c;"><i class="fas fa-edit"></i></div>
            <div>
                <h4 class="mb-0 fw-800">Modifier la formation</h4>
                <p class="text-muted mb-0 small">Édition de : {{ formation.nom }}</p>
            </div>
        </div>
        <div class="p-4 p-md-5">
            {{ include('formation/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
            {#<div class="mt-4 pt-3 border-top d-flex justify-content-end">
                {{ include('formation/_delete_form.html.twig') }}
            </div>#}
        </div>
    </div>
</div>
{% endblock %}