{% extends 'base.html.twig' %}

{% block title %}Liste des Formations{% endblock %}

{% block body %}
<div class="main-wrapper mt-5">
    <div class="form-card-wide">
        <div class="card-header-modern justify-content-between">
            <div class="d-flex align-items-center">
                <a href="{{ path('app_home') }}" class="btn btn-outline-secondary btn-sm shadow-sm me-3">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <div class="header-icon" style="background: var(--primary-light); color: var(--primary);">
                    <i class="fas fa-book"></i>
                </div>
                <div>
                    <h4 class="mb-0 fw-800">Catalogue Formations</h4>
                    <p class="text-muted mb-0 small">Gérez vos programmes de formation</p>
                </div>
            </div>
            <div class="d-flex gap-2">
                <a href="{{ path('app_export_formation_form') }}" class="btn btn-outline-success">
                    <i class="fas fa-graduation-cap me-2"></i>Exporter
                </a>
                <a href="{{ path('app_formation_new') }}" class="btn btn-cute">
                    <i class="fas fa-plus me-2"></i>Nouvel évènement
                </a>
            </div>
        </div>

        <div class="px-4">
            {{ include('_search_bar.html.twig') }}
        </div>

        {# TOTAUX #}
        {% set totalFormations = formations|length %}
        {% set totalParticipants = 0 %}
        {% set totalBeneficiaires = 0 %}
        {% for formation in formations %}
            {% set totalParticipants = totalParticipants + formation.getNbParticipants %}
            {% set totalBeneficiaires = totalBeneficiaires + formation.getTotalBeneficiaires %}
        {% endfor %}

        <div class="row g-3 px-4 mb-4">
            <div class="col-md-4">
                <div class="card border-0 shadow-sm" style="background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);">
                    <div class="card-body text-center">
                        <small class="text-muted text-uppercase fw-bold">Nombre de formations</small>
                        <h3 class="fw-bold text-primary mb-0">{{ totalFormations }}</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm" style="background: linear-gradient(135deg, #f0f7ee 0%, #e6f0e6 100%);">
                    <div class="card-body text-center">
                        <small class="text-muted text-uppercase fw-bold">Nombre d'adhérents participants</small>
                        <h3 class="fw-bold text-success mb-0">{{ totalParticipants }}</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm" style="background: linear-gradient(135deg, #f3e5f5 0%, #e1bee7 100%);">
                    <div class="card-body text-center">
                        <small class="text-muted text-uppercase fw-bold">Nombre de bénéficiaires (formés)</small>
                        <h3 class="fw-bold text-purple mb-0">{{ totalBeneficiaires }}</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="p-0">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Formation</th>
                        <th>Formateurs</th>
                        <th>Période</th>
                        <th>Nb adhérents participants</th>
                        <th>Nb bénéficiaires (formés)</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for formation in formations %}
                    <tr>
                        <td class="ps-4">
                            <div class="fw-bold text-dark">{{ formation.nom }}</div>
                        </td>
                        <td><span class="badge bg-light text-primary rounded-pill">{{ formation.formateurs|default('-') }}</span></td>
                        <td>
                            <div class="small">Du {{ formation.dateDebut ? formation.dateDebut|date('d/m/Y') : '-' }}</div>
                            <div class="small">Au {{ formation.dateFin ? formation.dateFin|date('d/m/Y') : '-' }}</div>
                        </td>
                        <td class="text-center">
                            <span class="badge bg-info">{{ formation.getNbParticipants }}</span>
                        </td>
                        <td class="text-center">
                            <span class="badge bg-success">{{ formation.getTotalBeneficiaires }}</span>
                        </td>
                        <td class="text-end pe-4">
                            <div class="d-flex justify-content-end gap-2">
                                <a href="{{ path('app_formation_show', {'id': formation.id}) }}" class="btn btn-sm btn-outline-primary" title="Voir participants">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="{{ path('app_formation_edit', {'id': formation.id}) }}" class="btn btn-sm btn-light rounded-3 text-primary">
                                    <i class="fas fa-pen"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">Aucune formation enregistrée.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}