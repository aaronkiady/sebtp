{% extends 'base.html.twig' %}

{% block title %}Formations de {{ adherent.nom }}{% endblock %}

{% block body %}
<div class="container mt-5">
    {# En-tête avec navigation #}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800">Parcours de Formation</h1>
            <p class="text-muted">Historique des sessions pour <strong>{{ adherent.nom }}</strong></p>
        </div>
        <a href="{{ path('app_liste_show', {'id': adherent.id}) }}" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left"></i> Retour à la fiche
        </a>
    </div>

    {# Statistiques rapides #}
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total Formations</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">{{ formations|length }}</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-graduation-cap fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Tableau des formations #}
    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">Liste des sessions suivies</h6>
            {#<a href="{{ path('app_formation_new') }}" class="btn btn-sm btn-primary">
                <i class="fas fa-plus"></i> Créer une nouvelle formation
            </a>#}
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover" id="dataTable" width="100%" cellspacing="0">
                    <thead class="table-light">
                        <tr>
                            <th>Formation</th>
                            <th>Type</th>
                            <th>Organisateur</th>
                            <th>Date Début</th>
                            <th>Date Fin</th>
                            <th>Durée</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for formation in formations %}
                        <tr>
                            <td>
                                <span class="fw-bold text-dark">{{ formation.nom }}</span>
                            </td>
                            <td>
                                <span class="badge bg-info text-dark">{{ formation.type }}</span>
                            </td>
                            <td>{{ formation.organisateur }}</td>
                            <td>{{ formation.dateDebut ? formation.dateDebut|date('d/m/Y') : '-' }}</td>
                            <td>{{ formation.dateFin ? formation.dateFin|date('d/m/Y') : '-' }}</td>
                            <td>
                                {% if formation.dateDebut and formation.dateFin %}
                                    {# Calcul simple de la durée en jours #}
                                    {{ formation.dateFin.diff(formation.dateDebut).days + 1 }} jours
                                {% else %}
                                    -
                                {% endif %}
                            </td>
                            <td class="text-center">
                                <div class="btn-group" role="group">
                                    <a href="{{ path('app_formation_show', {'id': formation.id}) }}" class="btn btn-sm btn-outline-primary" title="Voir participants">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a href="{{ path('app_formation_edit', {'id': formation.id}) }}" class="btn btn-sm btn-outline-warning" title="Modifier">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7" class="text-center py-4">
                                <div class="text-muted">
                                    <i class="fas fa-info-circle"></i> Cet adhérent n'a participé à aucune formation pour le moment.
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .border-left-primary {
            border-left: 0.25rem solid #4e73df !important;
        }
        .text-xs {
            font-size: .7rem;
        }
        .table-hover tbody tr:hover {
            background-color: rgba(0,0,0,.03);
        }
    </style>
{% endblock %}