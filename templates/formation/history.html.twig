{% extends 'base.html.twig' %}

{% block title %}Formations de {{ adherent.nom }}{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800">Parcours de Formation</h1>
            <p class="text-muted">Historique des sessions pour <strong>{{ adherent.nom }}</strong></p>
        </div>
        <a href="{{ path('app_liste_show', {'id': adherent.id}) }}" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left"></i> Retour à la fiche
        </a>
    </div>

    {% for message in app.flashes('info') %}
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            <i class="fas fa-info-circle me-2"></i>{{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {% if adherent.statut == 'radie' %}
        <div class="alert alert-warning">
            <i class="fas fa-exclamation-triangle me-2"></i>
            <strong>Adhérent radié :</strong> Cet adhérent a été radié. L'historique des formations n'est pas disponible.
        </div>
    {% elseif formations|length > 0 %}
        <div class="row mb-4">
            <div class="col-md-4">
                <div class="card border-left-primary shadow h-100 py-2">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total Formations</div>
                                <div class="h5 mb-0 font-weight-bold text-gray-800">{{ formations|length }}</div>
                            </div>
                            <div class="col-auto">
                                <i class="fas fa-graduation-cap fa-2x text-gray-300"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow mb-4">
            <div class="card-header py-3 d-flex justify-content-between align-items-center">
                <h6 class="m-0 font-weight-bold text-primary">Liste des sessions suivies</h6>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover" id="dataTable" width="100%" cellspacing="0">
                        <thead class="table-light">
                            <tr>
                                <th>Formation</th>
                                <th>Type</th>
                                <th>Organisateur</th>
                                <th>Date Début</th>
                                <th>Date Fin</th>
                                <th>Durée</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for formation in formations %}
                            <tr>
                                <td><span class="fw-bold text-dark">{{ formation.nom }}</span></td>
                                <td><span class="badge bg-info text-dark">{{ formation.type }}</span></td>
                                <td>{{ formation.organisateur }}</td>
                                <td>{{ formation.dateDebut ? formation.dateDebut|date('d/m/Y') : '-' }}</td>
                                <td>{{ formation.dateFin ? formation.dateFin|date('d/m/Y') : '-' }}</td>
                                <td>
                                    {% if formation.dateDebut and formation.dateFin %}
                                        {{ formation.dateFin.diff(formation.dateDebut).days }} jours
                                    {% else %}
                                        -
                                    {% endif %}
                                </td>
                                <td class="text-center">
                                    <div class="btn-group" role="group">
                                        <a href="{{ path('app_formation_show_participants', {'id': formation.id}) }}" class="btn btn-sm btn-outline-primary" title="Voir participants">
                                            <i class="fas fa-users"></i>
                                        </a>
                                        <a href="{{ path('app_formation_edit', {'id': formation.id}) }}" class="btn btn-sm btn-outline-warning" title="Modifier">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    {% else %}
        <div class="card shadow mb-4">
            <div class="card-body text-center py-5">
                <div class="text-muted">
                    <i class="fas fa-info-circle fa-3x mb-3 d-block opacity-25"></i>
                    <p>Cet adhérent n'a participé à aucune formation pour le moment.</p>
                </div>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .border-left-primary {
            border-left: 0.25rem solid #4e73df !important;
        }
        .text-xs {
            font-size: .7rem;
        }
        .table-hover tbody tr:hover {
            background-color: rgba(0,0,0,.03);
        }
    </style>
{% endblock %}