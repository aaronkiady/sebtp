{{ form_start(form) }}
    <div class="row g-4">
        <div class="col-md-8">
            <label class="form-label">
                <i class="fas fa-graduation-cap me-2 opacity-50"></i>Nom de la formation
            </label>
            {{ form_widget(form.nom, {'attr': {'class': 'form-control custom-input', 'placeholder': 'Ex: Management de projet'}}) }}
        </div>
        
        <div class="col-md-4">
            <label class="form-label">
                <i class="fas fa-tag me-2 opacity-50"></i>Type
            </label>
            {{ form_widget(form.type, {'attr': {'class': 'form-control custom-input'}}) }}
        </div>

        <div class="col-md-6">
            <label class="form-label">
                <i class="far fa-calendar-plus me-2 opacity-50"></i>Date de début
            </label>
            {{ form_widget(form.dateDebut, {'attr': {'class': 'form-control custom-input'}}) }}
        </div>

        <div class="col-md-6">
            <label class="form-label">
                <i class="far fa-calendar-check me-2 opacity-50"></i>Date de fin
            </label>
            {{ form_widget(form.dateFin, {'attr': {'class': 'form-control custom-input'}}) }}
        </div>

        <div class="col-md-12">
            <label class="form-label">
                <i class="fas fa-university me-2 opacity-50"></i>Organisateur
            </label>
            {{ form_widget(form.organisateur, {'attr': {'class': 'form-control custom-input', 'placeholder': 'Ex: Cabinet de formation X'}}) }}
        </div>
    </div>

    <div class="mb-4">
    <label class="form-label fw-bold text-dark mb-3">
        <i class="fas fa-users me-2 text-primary"></i>{{ form_label(form.participants) }}
    </label>
    
    <div class="row g-3">
        {% for child in form.participants %}
            <div class="col-6 col-md-4 col-lg-3"> {# 2 par ligne sur mobile, 3 sur tablette, 4 sur desktop #}
                <div class="participant-checkbox-card p-2 border rounded-3 bg-white shadow-sm h-100 transition-all">
                    <div class="form-check d-flex align-items-center gap-2 mb-0">
                        {{ form_widget(child, {'attr': {'class': 'form-check-input mt-0'}}) }}
                        {{ form_label(child, null, {'label_attr': {'class': 'form-check-label small fw-semibold text-truncate', 'style': 'cursor:pointer;'}}) }}
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
    {{ form_errors(form.participants) }}
</div>

    <div class="mt-5 pt-4 border-top d-flex justify-content-end gap-3">
        <a href="{{ path('app_formation_index') }}" class="btn-action btn-cancel text-decoration-none">Annuler</a>
        <button type="submit" class="btn-action btn-update">
            <i class="fas fa-check-circle me-2"></i> {{ button_label|default('Enregistrer') }}
        </button>
    </div>
{{ form_end(form) }}