{{ form_start(form) }}
    <div class="form-card-wide mx-auto my-4">
        <div class="card-header-modern">
            <div class="header-icon">
                <i class="fas fa-graduation-cap"></i>
            </div>
            <div>
                <h4 class="mb-0 fw-800">Informations de la formation</h4>
                <p class="text-muted mb-0 small">Renseignez les détails de la formation</p>
            </div>
        </div>

        <div class="p-4 p-md-5" id="form-content">
            <div class="row g-4">
                <div class="col-md-6">
                    <label class="form-label">{{ form.nom.vars.label }}</label>
                    {{ form_widget(form.nom, {'attr': {'class': 'form-control custom-input'}}) }}
                    <div class="text-danger small mt-1">{{ form_errors(form.nom) }}</div>
                </div>

                <div class="col-md-6">
                    <label class="form-label">{{ form.reference.vars.label }}</label>
                    {{ form_widget(form.reference, {'attr': {'class': 'form-control custom-input'}}) }}
                    <div class="text-danger small mt-1">{{ form_errors(form.reference) }}</div>
                </div>

                <div class="col-md-6">
                    <label class="form-label">{{ form.type.vars.label }}</label>
                    {{ form_widget(form.type, {'attr': {'class': 'form-control custom-input'}}) }}
                    <div class="text-danger small mt-1">{{ form_errors(form.type) }}</div>
                </div>

                <div class="col-md-6">
                    <label class="form-label">{{ form.organisateur.vars.label }}</label>
                    {{ form_widget(form.organisateur, {'attr': {'class': 'form-control custom-input'}}) }}
                    <div class="text-danger small mt-1">{{ form_errors(form.organisateur) }}</div>
                </div>

                <div class="col-md-6">
                    <label class="form-label">{{ form.dateDebut.vars.label }}</label>
                    {{ form_widget(form.dateDebut, {'attr': {'class': 'form-control custom-input'}}) }}
                    <div class="text-danger small mt-1">{{ form_errors(form.dateDebut) }}</div>
                </div>

                <div class="col-md-6">
                    <label class="form-label">{{ form.dateFin.vars.label }}</label>
                    {{ form_widget(form.dateFin, {'attr': {'class': 'form-control custom-input'}}) }}
                    <div class="text-danger small mt-1">{{ form_errors(form.dateFin) }}</div>
                </div>

                <div class="col-md-12">
                    <label class="form-label">{{ form.remarque.vars.label }}</label>
                    {{ form_widget(form.remarque, {'attr': {'class': 'form-control custom-input', 'rows': 3}}) }}
                    <div class="text-danger small mt-1">{{ form_errors(form.remarque) }}</div>
                </div>

                {# Sélection des participants avec cases à cocher et recherche #}
                <div class="col-md-12">
                    <label class="form-label fw-bold">{{ form.participants.vars.label }}</label>
                    
                    {# Barre de recherche #}
                    <div class="mb-2">
                        <div class="input-group">
                            <input type="text" id="participant-search" class="form-control" placeholder="Rechercher un adhérent...">
                            <button class="btn btn-outline-secondary" type="button" id="clear-search">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                        <small class="text-muted">Tapez pour filtrer les adhérents</small>
                    </div>
                    
                    {# Conteneur des cases à cocher #}
                    <div class="border rounded-3 p-3" style="max-height: 350px; overflow-y: auto;" id="participants-list-container">
                        {{ form_widget(form.participants) }}
                    </div>
                    <small class="text-muted">Cochez les adhérents participants à cette formation (les adhérents radiés ne sont pas affichés)</small>
                    <div class="text-danger small mt-1">{{ form_errors(form.participants) }}</div>
                </div>

                {# Champs dynamiques pour les détails des participants #}
                <div class="col-md-12" id="participants-details-container" style="display: none;">
                    <div class="card border mt-3">
                        <div class="card-header bg-white">
                            <h6 class="fw-bold mb-0">
                                <i class="fas fa-users me-2 text-primary"></i>
                                Détails des participants (agents / représentants)
                            </h6>
                            <small class="text-muted">Précisez les noms des agents qui participeront pour chaque adhérent</small>
                        </div>
                        <div class="card-body" id="participants-details-list">
                            {# Les champs seront ajoutés dynamiquement ici #}
                        </div>
                    </div>
                </div>

                <div class="col-md-12">
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>
                        <strong>Information :</strong> Après avoir sélectionné les participants, vous pourrez saisir les noms des agents pour chaque adhérent.
                    </div>
                </div>
            </div>

            <div class="mt-5 pt-4 border-top d-flex justify-content-end gap-3">
                <a href="{{ path('app_formation_index') }}" class="btn-action btn-cancel text-decoration-none">
                    <i class="fas fa-times me-2"></i> Annuler
                </a>
                <button type="submit" class="btn-action btn-update">
                    <i class="fas fa-save me-2"></i> {{ button_label|default('Enregistrer') }}
                </button>
            </div>
        </div>
    </div>
{{ form_end(form) }}

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Récupérer le conteneur des cases à cocher
    const participantsContainer = document.querySelector('#{{ form.participants.vars.id }}');
    const container = document.getElementById('participants-details-container');
    const detailsList = document.getElementById('participants-details-list');
    const searchInput = document.getElementById('participant-search');
    const clearBtn = document.getElementById('clear-search');
    let existingDetails = {};

    // Récupérer les détails existants (pour l'édition)
    {% if form.vars.value.participantsDetails is defined and form.vars.value.participantsDetails %}
        existingDetails = {{ form.vars.value.participantsDetails|json_encode|raw }};
    {% endif %}

    // Fonction pour filtrer les cases à cocher
    function filterCheckboxes() {
        const searchTerm = searchInput.value.toLowerCase();
        const checkboxes = participantsContainer.querySelectorAll('.checkbox-item');
        
        checkboxes.forEach(item => {
            const label = item.querySelector('label');
            const text = label ? label.textContent.toLowerCase() : '';
            if (text.includes(searchTerm)) {
                item.style.display = 'flex';
            } else {
                item.style.display = 'none';
            }
        });
    }

    // Fonction pour obtenir les participants sélectionnés
    function getSelectedParticipants() {
        const checkboxes = participantsContainer.querySelectorAll('input[type="checkbox"]:checked');
        const selected = [];
        checkboxes.forEach(cb => {
            const parentDiv = cb.closest('.checkbox-item');
            const label = parentDiv ? parentDiv.querySelector('label') : null;
            selected.push({
                id: cb.value,
                name: label ? label.textContent : ''
            });
        });
        return selected;
    }

    // Fonction pour mettre à jour les détails des participants
    function updateParticipantsDetails() {
        const selected = getSelectedParticipants();
        
        detailsList.innerHTML = '';
        
        if (selected.length > 0) {
            container.style.display = 'block';
            
            for (let i = 0; i < selected.length; i++) {
                const id = selected[i].id;
                const name = selected[i].name;
                const existingValue = existingDetails[id] || '';
                
                const div = document.createElement('div');
                div.className = 'mb-3 pb-3 border-bottom';
                div.innerHTML = `
                    <div class="row g-3 align-items-center">
                        <div class="col-md-4">
                            <label class="form-label fw-bold mb-0">
                                <i class="fas fa-building me-1 text-primary"></i>
                                ${escapeHtml(name)}
                            </label>
                            <input type="hidden" name="participant_id_${id}" value="${id}" class="participant-id">
                        </div>
                        <div class="col-md-8">
                            <label class="form-label small text-muted">Noms des agents / représentants</label>
                            <input type="text" 
                                   name="participant_detail_${id}" 
                                   class="form-control participant-detail" 
                                   placeholder="Ex: Jean Martin (DG), Marie Claire (RH)..."
                                   value="${escapeHtml(existingValue)}">
                            <small class="text-muted">Séparez les noms par des virgules si plusieurs agents</small>
                        </div>
                    </div>
                `;
                detailsList.appendChild(div);
            }
        } else {
            container.style.display = 'none';
        }
    }

    function escapeHtml(str) {
        if (!str) return '';
        return str.replace(/[&<>]/g, function(m) {
            if (m === '&') return '&amp;';
            if (m === '<') return '&lt;';
            if (m === '>') return '&gt;';
            return m;
        });
    }

    // Ajouter une classe aux divs contenant les checkboxes pour faciliter le filtrage
    if (participantsContainer) {
        const checkboxItems = participantsContainer.querySelectorAll('div');
        checkboxItems.forEach(item => {
            if (item.querySelector('input[type="checkbox"]')) {
                item.classList.add('checkbox-item');
                item.style.display = 'flex';
                item.style.alignItems = 'center';
                item.style.gap = '8px';
                item.style.padding = '8px';
                item.style.borderRadius = '8px';
                item.style.cursor = 'pointer';
                
                // Rendre toute la div cliquable
                item.addEventListener('click', function(e) {
                    if (e.target.tagName !== 'INPUT') {
                        const checkbox = this.querySelector('input[type="checkbox"]');
                        if (checkbox) {
                            checkbox.checked = !checkbox.checked;
                            // Déclencher l'événement change
                            const event = new Event('change', { bubbles: true });
                            checkbox.dispatchEvent(event);
                        }
                    }
                });
            }
        });
        
        // Écouter les changements sur les checkboxes
        participantsContainer.addEventListener('change', function() {
            updateParticipantsDetails();
        });
    }

    // Écouter la recherche
    if (searchInput) {
        searchInput.addEventListener('input', filterCheckboxes);
    }

    // Bouton effacer la recherche
    if (clearBtn) {
        clearBtn.addEventListener('click', function() {
            searchInput.value = '';
            filterCheckboxes();
        });
    }

    // Déclencher la mise à jour initiale
    setTimeout(updateParticipantsDetails, 100);
});
</script>

<style>
.participants-checkbox-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
}
.checkbox-item {
    display: flex;
    align-items: center;
    padding: 8px 12px;
    border-radius: 8px;
    transition: background-color 0.2s;
}
.checkbox-item:hover {
    background-color: #f8f9fa;
}
.checkbox-item label {
    margin-left: 10px;
    cursor: pointer;
    flex: 1;
}
.checkbox-item input[type="checkbox"] {
    margin-right: 10px;
    cursor: pointer;
    transform: scale(1.1);
}
.custom-input:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 0.2rem rgba(79, 70, 229, 0.25);
}
#participant-search:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 0.2rem rgba(79, 70, 229, 0.25);
}
</style>