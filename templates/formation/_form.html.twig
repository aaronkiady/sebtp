{{ form_start(form) }}
<div class="row g-4">
    <div class="col-md-6">
        {{ form_row(form.nom) }}
    </div>
    <div class="col-md-6">
        {{ form_row(form.formateurs) }}
    </div>
    <div class="col-md-6">
        {{ form_row(form.dateDebut) }}
    </div>
    <div class="col-md-6">
        {{ form_row(form.dateFin) }}
    </div>
    <div class="col-md-12">
        {{ form_row(form.organisateur) }}
    </div>
    <div class="col-md-12">
        {{ form_row(form.reference) }}
    </div>
    <div class="col-md-12">
        {{ form_row(form.remarque) }}
    </div>
</div>

<div class="mt-4 pt-3 border-top d-flex justify-content-end gap-3">
    <a href="{{ path('app_formation_index') }}" class="btn btn-outline-secondary">
        <i class="fas fa-times me-2"></i> Annuler
    </a>
    <button type="submit" class="btn btn-primary">
        <i class="fas fa-save me-2"></i> {{ button_label|default('Enregistrer') }}
    </button>
</div>
{{ form_end(form) }}