{% extends 'base.html.twig' %}

{% block title %}Ajouter un participant - {{ formation.nom }}{% endblock %}

{% block body %}
<div class="main-wrapper mt-5">
    <div class="form-card-wide p-4">
        <div class="d-flex justify-content-between align-items-start mb-4">
            <div class="d-flex align-items-center">
                <a href="{{ path('app_formation_show_participants', {'id': formation.id}) }}" class="btn btn-outline-secondary btn-sm shadow-sm me-3">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <div class="header-icon" style="background: var(--primary-light); color: var(--primary);">
                    <i class="fas fa-user-plus"></i>
                </div>
                <div>
                    <h1 class="h2 fw-bold text-dark mb-0">Ajouter un participant</h1>
                    <p class="text-muted mb-0">{{ formation.nom }}</p>
                </div>
            </div>
        </div>

        <div class="alert alert-info mb-4">
            <i class="fas fa-info-circle me-2"></i>
            <strong>Information :</strong> Seuls les adhérents <strong>actifs</strong> peuvent être ajoutés.
            <br>
            <small>Les adhérents radiés ne sont pas affichés dans la liste.</small>
        </div>

        {{ form_start(form) }}
            <div class="row g-4">
                <div class="col-md-8">
                    <label class="form-label">Adhérent <span class="text-danger">*</span></label>
                    {{ form_widget(form.participant, {'attr': {'class': 'form-control custom-input'}}) }}
                    <div class="text-danger small mt-1">{{ form_errors(form.participant) }}</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Nombre de bénéficiaires (formés)</label>
                    {{ form_widget(form.nombreBeneficiaires, {'attr': {'class': 'form-control custom-input'}}) }}
                    <div class="text-danger small mt-1">{{ form_errors(form.nombreBeneficiaires) }}</div>
                </div>
            </div>

            <div class="mt-5 pt-4 border-top d-flex justify-content-end gap-3">
                <a href="{{ path('app_formation_show_participants', {'id': formation.id}) }}" class="btn btn-outline-secondary">
                    <i class="fas fa-times me-2"></i> Annuler
                </a>
                <button type="submit" class="btn btn-success">
                    <i class="fas fa-user-plus me-2"></i> Ajouter
                </button>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}