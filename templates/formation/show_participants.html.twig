{% extends 'base.html.twig' %}

{% block title %}Participants - {{ formation.nom }}{% endblock %}

{% block body %}
<div class="main-wrapper mt-5">
    <div class="form-card-wide p-4">
        <div class="d-flex justify-content-between align-items-start mb-4">
            <div class="d-flex align-items-center">
                <a href="{{ path('app_formation_index') }}" class="btn btn-outline-secondary btn-sm shadow-sm me-3">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <div class="header-icon" style="background: var(--primary-light); color: var(--primary);">
                    <i class="fas fa-users"></i>
                </div>
                <div>
                    <h1 class="h2 fw-bold text-dark mb-0">{{ formation.nom }}</h1>
                    <p class="text-muted mb-0">Gestion des participants et bénéficiaires</p>
                </div>
            </div>
            <a href="{{ path('app_formation_ajouter_participant', {'id': formation.id}) }}" class="btn btn-success">
                <i class="fas fa-plus me-2"></i> Ajouter un participant
            </a>
        </div>

        {{ form_start(form) }}
            <div class="table-responsive">
                <table class="table table-bordered">
                    <thead class="table-light">
                        <tr>
                            <th>Adhérent</th>
                            <th class="text-center">Nombre de bénéficiaires (formés)</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for participant in formation.participants %}
                            <tr>
                                <td class="fw-bold">
                                    <a href="{{ path('app_liste_show', {'id': participant.id}) }}" class="text-decoration-none">
                                        {{ participant.nom }}
                                    </a>
                                </td>
                                <td class="text-center" style="width: 200px;">
                                    {{ form_widget(form['nombre_' ~ participant.id], {'attr': {'class': 'form-control text-center', 'min': 0}}) }}
                                </td>
                                <td class="text-center">
                                    <form method="post" action="{{ path('app_formation_retirer_participant', {'id': formation.id, 'participant_id': participant.id}) }}" 
                                          onsubmit="return confirm('Êtes-vous sûr de vouloir retirer ce participant ?');" 
                                          style="display: inline-block;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('retirer_participant_' ~ participant.id) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Retirer">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="3" class="text-center py-5">
                                    <p class="text-muted">Aucun participant inscrit à cette formation.</p>
                                    <a href="{{ path('app_formation_ajouter_participant', {'id': formation.id}) }}" class="btn btn-sm btn-success">
                                        <i class="fas fa-plus me-1"></i> Ajouter un participant
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <td class="fw-bold">TOTAL</td>
                            <td class="text-center fw-bold text-success">
                                {{ formation.getTotalBeneficiaires }}
                            </td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-3">
                <a href="{{ path('app_formation_index') }}" class="btn btn-outline-secondary">
                    <i class="fas fa-times me-2"></i> Annuler
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save me-2"></i> Enregistrer
                </button>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}