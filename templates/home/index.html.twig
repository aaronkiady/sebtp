{% extends 'base.html.twig' %}

{% block title %}Dashboard | SEBTP{% endblock %}

{% block body %}
<div class="container-fluid py-4">

    {# 1. ENTÊTE DU DASHBOARD 
    <div class="dashboard-header d-flex justify-content-between align-items-center flex-wrap mb-4">
        <div>
             
        </div>
        <div class="text-end d-none d-md-block">
            <span class="badge bg-light text-dark border p-2 rounded-3">
                <i class="far fa-calendar-alt me-1"></i> {{ "now"|date("d/m/Y") }}
            </span>
        </div>
    </div>#}

    {# 2. LIGNE HAUTE : Plateforme SEBTP | Résumé adhérents | Total + Demandes #}
    <div class="row g-3 mb-4">
        {# Col 1: Plateforme SEBTP #}
        <div class="col-md-4 col-lg-4">
            <div class="card-modern p-3 h-100">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <div class="header-icon" style="background: var(--primary-light); color: var(--primary);">
                        <i class="fas fa-building"></i>
                    </div>
                    <h6 class="fw-bold mb-0">Plateforme SEBTP</h6>
                </div>
                <p class="small text-muted mb-2">
                    Gérez vos adhérents et suivez les cotisations depuis ce tableau de bord.
                </p>
                <div class="mt-2">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="small">👥 Gestion des membres</span>
                        <span class="text-success small">✔</span>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="small">💰 Suivi des cotisations</span>
                        <span class="text-success small">✔</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="small">🎓 Suivi des formations</span>
                        <span class="text-success small">✔</span>
                    </div>
                </div>
            </div>
        </div>

        {# Col 2: Résumé des adhérents #}
        <div class="col-md-4 col-lg-4">
            <div class="card-modern p-3 h-100">
                <h6 class="fw-bold mb-3 text-center">Résumé des Adhérents</h6>
                <div class="d-flex flex-column gap-2">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="small text-muted">Actifs</span>
                        <span class="badge bg-success-soft text-success rounded-pill">{{ nb_actifs }}</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="small text-muted">Inactifs</span>
                        <span class="badge bg-warning-soft text-warning rounded-pill">{{ nb_inactifs }}</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="small text-muted">Radiés</span>
                        <span class="badge bg-danger-soft text-danger rounded-pill">{{ nb_radies }}</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center pt-2 mt-1 border-top">
                        <span class="small fw-bold">Total</span>
                        <span class="fw-bold">{{ nb_actifs + nb_inactifs + nb_radies + nb_demande }}</span>
                    </div>
                </div>
            </div>
        </div>

        {# Col 3: Carte rose + Demandes #}
        <div class="col-md-4 col-lg-4 d-flex flex-column gap-3">
            <div class="stat-card rose p-3 flex-fill">
                <i class="fas fa-users"></i>
                <div>
                    <h3>{{ nb_actifs + nb_inactifs + nb_radies + nb_demande }}</h3>
                    <p>Adhérents au total</p>
                    <small class="badge bg-white text-success mt-1">{{ nb_actifs }} actifs</small>
                </div>
            </div>
            <div class="card-modern p-3 border-start border-warning border-4 shadow-sm">
                <h6 class="text-muted small mb-1">En attente</h6>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="fw-bold text-warning">{{ nb_demande }} demandes</span>
                    <a href="{{ path('app_liste_index') }}?statut=demande" class="btn btn-light-modern btn-sm">
                        <i class="fas fa-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    {# 3. LIGNE DES GRAPHIQUES COTISATIONS #}
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card-modern p-4 h-100">
                <h6 class="fw-bold mb-4 text-center">Cotisations {{ "now"|date('Y') }}</h6>
                <canvas id="chartN" height="200"></canvas>
                <div class="text-center mt-3">
                    <span class="badge bg-success me-2">Payé : {{ statsN.pourcentagePaye|default(0) }}%</span>
                    <span class="badge bg-danger">Impayé : {{ statsN.pourcentageImpaye|default(0) }}%</span>
                </div>
                <div class="text-center mt-2 small text-muted">
                    Basé sur {{ statsN.total|default(0) }} adhérents actifs
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card-modern p-4 h-100">
                <h6 class="fw-bold mb-4 text-center">Cotisations {{ "now"|date('Y') - 1 }}</h6>
                <canvas id="chartN1" height="200"></canvas>
                <div class="text-center mt-3">
                    <span class="badge bg-success me-2">Payé : {{ statsN1.pourcentagePaye|default(0) }}%</span>
                    <span class="badge bg-danger">Impayé : {{ statsN1.pourcentageImpaye|default(0) }}%</span>
                </div>
                <div class="text-center mt-2 small text-muted">
                    Historique année passée
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card-modern p-4 h-100">
                <h6 class="fw-bold mb-4 text-center">Événements (tous les adhérents)</h6>
                <canvas id="chartEvenementsGlobal" height="200"></canvas>
                <div class="text-center mt-3">
                    <span class="badge bg-success me-2">Payé : {{ statsGlobalEvenements.pourcentagePaye|default(0) }}%</span>
                    <span class="badge bg-danger">Impayé : {{ statsGlobalEvenements.pourcentageImpaye|default(0) }}%</span>
                </div>
                <div class="text-center mt-2 small text-muted">
                    Total participations : <strong>{{ statsGlobalEvenements.total|default(0) }}</strong>
                </div>
            </div>
        </div>
    </div>

    {# 4. LIGNE : Actions rapides | Cartes Évènements et Formations | Annuaire #}
    <div class="row g-3 mb-4">
        {# Col 1: Actions rapides #}
        <div class="col-md-4">
            <div class="card-modern p-3 h-100">
                <h6 class="fw-bold mb-3">Actions rapides ⚡</h6>
                <div class="d-flex flex-column gap-2">
                    <a href="{{ path('app_liste_new') }}" class="btn btn-cute w-100 text-start">
                        <i class="fas fa-user-plus me-2"></i> Ajouter adhérent
                    </a>
                    <a href="{{ path('app_evenement_new') }}" class="btn btn-light-modern border w-100 text-start">
                        <i class="fas fa-calendar-plus me-2"></i> Créer évènement
                    </a>
                    <a href="{{ path('app_formation_index') }}" class="btn btn-light-modern border w-100 text-start">
                        <i class="fas fa-book me-2"></i> Voir formations
                    </a>
                </div>
            </div>
        </div>

        {# Col 2: Cartes Évènements et Formations #}
        <div class="col-md-4">
            <div class="row g-3 h-100">
                <div class="col-12">
                    <div class="stat-card blue p-3 h-100">
                        <i class="fas fa-calendar-alt"></i>
                        <div>
                            <h3>{{ total_evenements|default(0) }}</h3>
                            <p>Évènements</p>
                            <small class="text-white-50">Programmés en base</small>
                        </div>
                    </div>
                </div>
                <div class="col-12">
                    <div class="stat-card purple p-3 h-100">
                        <i class="fas fa-graduation-cap"></i>
                        <div>
                            <h3>{{ total_formations|default(0) }}</h3>
                            <p>Formations</p>
                            <small class="text-white-50">Modules enregistrés</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# Col 3: Annuaire Adhérents #}
        <div class="col-md-4">
            <div class="module-card p-3 h-100">
                <i class="fas fa-address-book icon mb-2"></i>
                <h6 class="fw-bold">Annuaire Adhérents</h6>
                <p class="small text-muted mb-2">{{ nb_actifs + nb_inactifs + nb_radies + nb_demande }} membres</p>
                <a href="{{ path('app_liste_index') }}" class="btn btn-light-modern w-100 mt-2">Explorer l'annuaire →</a>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const chartOptions = {
        plugins: { legend: { position: 'bottom' } },
        cutout: '70%',
        responsive: true,
        maintainAspectRatio: false
    };

    // Graphique cotisations année en cours
    new Chart(document.getElementById('chartN'), {
        type: 'doughnut',
        data: {
            labels: ['Payé', 'Impayé'],
            datasets: [{
                data: [{{ statsN.paye|default(0) }}, {{ statsN.impaye|default(0) }}],
                backgroundColor: ['#10b981', '#fecaca'],
                borderWidth: 0
            }]
        },
        options: chartOptions
    });

    // Graphique cotisations année précédente
    new Chart(document.getElementById('chartN1'), {
        type: 'doughnut',
        data: {
            labels: ['Payé', 'Impayé'],
            datasets: [{
                data: [{{ statsN1.paye|default(0) }}, {{ statsN1.impaye|default(0) }}],
                backgroundColor: ['#42a5f5', '#ff0026'],
                borderWidth: 0
            }]
        },
        options: chartOptions
    });

    // Graphique global des événements
    {% if statsGlobalEvenements.total|default(0) > 0 %}
    new Chart(document.getElementById('chartEvenementsGlobal'), {
        type: 'doughnut',
        data: {
            labels: ['Payé', 'Impayé'],
            datasets: [{
                data: [{{ statsGlobalEvenements.paye|default(0) }}, {{ statsGlobalEvenements.impaye|default(0) }}],
                backgroundColor: ['#10b981', '#fecaca'],
                borderWidth: 0
            }]
        },
        options: {
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: { font: { size: 11 } }
                }
            },
            cutout: '70%',
            responsive: true,
            maintainAspectRatio: false
        }
    });
    {% endif %}
</script>
{% endblock %}