{% extends 'base.html.twig' %}

{% block title %}Dashboard | SEBTP{% endblock %}

{% block body %}
<div class="container-fluid py-4">

    {# 1. ENTÊTE DU DASHBOARD #}
    <div class="dashboard-header d-flex justify-content-between align-items-center flex-wrap mb-4">
        <div>
            <h2 class="fw-bold">
                Bonjour, <span class="text-gradient">{{ app.user.nom|default('Admin') }}</span> 👋
            </h2>
            <p class="text-muted mb-0">Voici ce qui se passe aujourd'hui dans votre organisation.</p>
        </div>
        <div class="text-end d-none d-md-block">
            <span class="badge bg-light text-dark border p-2 rounded-3">
                <i class="far fa-calendar-alt me-1"></i> {{ "now"|date("d/m/Y") }}
            </span>
        </div>
    </div>

    {# 2. LIGNE HAUTE : Plateforme SEBTP | Résumé des adhérents | Total adhérents #}
    <div class="row g-3 mb-4">
        {# Colonne 1: Plateforme SEBTP #}
        <div class="col-md-4">
            <div class="card-modern p-3 h-100">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <div class="header-icon" style="background: var(--primary-light); color: var(--primary); width: 35px; height: 35px; font-size: 1rem;">
                        <i class="fas fa-building"></i>
                    </div>
                    <h6 class="fw-bold mb-0">Plateforme SEBTP</h6>
                </div>
                <p class="small text-muted mb-2">
                    Gérez efficacement vos adhérents et suivez les cotisations.
                </p>
                <div class="small">
                    <div class="d-flex justify-content-between mb-1">
                        <span>👥 Gestion des membres</span>
                        <span class="text-success">✔</span>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span>💰 Suivi des cotisations</span>
                        <span class="text-success">✔</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span>🎓 Suivi des formations</span>
                        <span class="text-success">✔</span>
                    </div>
                </div>
            </div>
        </div>

        {# Colonne 2: Résumé des adhérents #}
        <div class="col-md-4">
            <div class="card-modern p-3 h-100">
                <h6 class="fw-bold mb-2 text-center">Résumé des Adhérents</h6>
                <div class="d-flex flex-wrap justify-content-between gap-2">
                    <div class="text-center flex-grow-1">
                        <span class="badge bg-success-soft text-success rounded-pill px-3 py-2">Actifs<br><strong class="fs-5">{{ nb_actifs }}</strong></span>
                    </div>
                    <div class="text-center flex-grow-1">
                        <span class="badge bg-warning-soft text-warning rounded-pill px-3 py-2">Inactifs<br><strong class="fs-5">{{ nb_inactifs }}</strong></span>
                    </div>
                    <div class="text-center flex-grow-1">
                        <span class="badge bg-danger-soft text-danger rounded-pill px-3 py-2">Radiés<br><strong class="fs-5">{{ nb_radies }}</strong></span>
                    </div>
                </div>
                <div class="text-center mt-2 pt-2 border-top">
                    <span class="small text-muted">Total adhérents :</span>
                    <strong class="fs-6">{{ nb_actifs + nb_inactifs + nb_radies + nb_demande }}</strong>
                </div>
            </div>
        </div>

        {# Colonne 3: Cadre rose (total adhérents) #}
        <div class="col-md-4">
            <div class="stat-card rose p-2 mb-2" style="padding: 12px !important;">
                <i class="fas fa-users" style="font-size: 20px;"></i>
                <div>
                    <h4 class="mb-0">{{ nb_actifs + nb_inactifs + nb_radies + nb_demande }}</h4>
                    <p class="mb-0 small">Adhérents au total</p>
                    <small class="badge bg-white text-success p-1 mt-1">{{ nb_actifs }} actifs</small>
                </div>
            </div>
            {# Demandes d'adhésion en cours #}
            <div class="card-modern p-2 border-start border-warning border-3 shadow-sm">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted small mb-0">En attente</h6>
                        <h4 class="fw-bold mb-0 text-warning">{{ nb_demande }} demandes</h4>
                    </div>
                    <a href="{{ path('app_liste_index') }}?statut=demande" class="btn btn-light-modern btn-sm">
                        Voir <i class="fas fa-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    {# 3. LIGNE DES GRAPHIQUES COTISATIONS + POURCENTAGES #}
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card-modern p-3 h-100">
                <h6 class="fw-bold mb-2 text-center small">Cotisations {{ "now"|date('Y') }}</h6>
                <canvas id="chartN" height="150"></canvas>
                <div class="text-center mt-2">
                    <span class="badge bg-success me-1">Payé: {{ statsN.pourcentagePaye|default(0) }}%</span>
                    <span class="badge bg-danger">Impayé: {{ statsN.pourcentageImpaye|default(0) }}%</span>
                </div>
                <div class="text-center mt-1 small text-muted">
                    {{ statsN.total }} adhérents actifs
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card-modern p-3 h-100">
                <h6 class="fw-bold mb-2 text-center small">Cotisations {{ "now"|date('Y') - 1 }}</h6>
                <canvas id="chartN1" height="150"></canvas>
                <div class="text-center mt-2">
                    <span class="badge bg-success me-1">Payé: {{ statsN1.pourcentagePaye|default(0) }}%</span>
                    <span class="badge bg-danger">Impayé: {{ statsN1.pourcentageImpaye|default(0) }}%</span>
                </div>
                <div class="text-center mt-1 small text-muted">
                    Année passée
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card-modern p-3 h-100">
                <h6 class="fw-bold mb-2 text-center small">Événements (tous adhérents)</h6>
                <canvas id="chartEvenementsGlobal" height="150"></canvas>
                <div class="text-center mt-2">
                    <span class="badge bg-success me-1">Payé: {{ statsGlobalEvenements.pourcentagePaye|default(0) }}%</span>
                    <span class="badge bg-danger">Impayé: {{ statsGlobalEvenements.pourcentageImpaye|default(0) }}%</span>
                </div>
                <div class="text-center mt-1 small text-muted">
                    Total: {{ statsGlobalEvenements.total|default(0) }} participations
                </div>
            </div>
        </div>
    </div>

    {# 4. ACTIONS RAPIDES #}
    <div class="card-modern p-3 mb-3">
        <h6 class="fw-bold mb-2">Actions rapides ⚡</h6>
        <div class="d-flex flex-wrap gap-2">
            <a href="{{ path('app_liste_new') }}" class="btn btn-cute btn-sm">
                <i class="fas fa-user-plus me-1"></i> Ajouter adhérent
            </a>
            <a href="{{ path('app_evenement_new') }}" class="btn btn-light-modern border btn-sm">
                <i class="fas fa-calendar-plus me-1"></i> Créer évènement
            </a>
            <a href="{{ path('app_formation_index') }}" class="btn btn-light-modern border btn-sm">
                <i class="fas fa-book me-1"></i> Voir formations
            </a>
        </div>
    </div>

    {# 5. LIGNE BASSE : Annuaire Adhérents | Évènements | Formations #}
    <div class="row g-3">
        <div class="col-md-4">
            <div class="module-card p-3">
                <i class="fas fa-address-book icon mb-2"></i>
                <h6 class="fw-bold">Annuaire Adhérents</h6>
                <p class="small text-muted mb-2">{{ nb_actifs + nb_inactifs + nb_radies + nb_demande }} membres</p>
                <a href="{{ path('app_liste_index') }}" class="btn btn-light-modern btn-sm w-100">Explorer →</a>
            </div>
        </div>
        <div class="col-md-4">
            <div class="module-card p-3">
                <i class="fas fa-calendar-alt icon mb-2"></i>
                <h6 class="fw-bold">Gestion Évènements</h6>
                <p class="small text-muted mb-2">{{ total_evenements }} évènements</p>
                <a href="{{ path('app_evenement_index') }}" class="btn btn-light-modern btn-sm w-100">Voir →</a>
            </div>
        </div>
        <div class="col-md-4">
            <div class="module-card p-3">
                <i class="fas fa-graduation-cap icon mb-2"></i>
                <h6 class="fw-bold">Gestion Formations</h6>
                <p class="small text-muted mb-2">{{ total_formations }} formations</p>
                <a href="{{ path('app_formation_index') }}" class="btn btn-light-modern btn-sm w-100">Voir →</a>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const chartOptions = {
        plugins: { 
            legend: { 
                position: 'bottom',
                labels: { font: { size: 9 } }
            } 
        },
        cutout: '65%',
        responsive: true,
        maintainAspectRatio: true
    };

    // Graphique cotisations année en cours
    new Chart(document.getElementById('chartN'), {
        type: 'doughnut',
        data: {
            labels: ['Payé', 'Impayé'],
            datasets: [{
                data: [{{ statsN.paye|default(0) }}, {{ statsN.impaye|default(0) }}],
                backgroundColor: ['#10b981', '#fecaca'],
                borderWidth: 0
            }]
        },
        options: chartOptions
    });

    // Graphique cotisations année précédente
    new Chart(document.getElementById('chartN1'), {
        type: 'doughnut',
        data: {
            labels: ['Payé', 'Impayé'],
            datasets: [{
                data: [{{ statsN1.paye|default(0) }}, {{ statsN1.impaye|default(0) }}],
                backgroundColor: ['#42a5f5', '#ff0026'],
                borderWidth: 0
            }]
        },
        options: chartOptions
    });

    // Graphique global des événements
    {% if statsGlobalEvenements.total|default(0) > 0 %}
    new Chart(document.getElementById('chartEvenementsGlobal'), {
        type: 'doughnut',
        data: {
            labels: ['Payé', 'Impayé'],
            datasets: [{
                data: [{{ statsGlobalEvenements.paye|default(0) }}, {{ statsGlobalEvenements.impaye|default(0) }}],
                backgroundColor: ['#10b981', '#fecaca'],
                borderWidth: 0
            }]
        },
        options: chartOptions
    });
    {% endif %}
</script>
{% endblock %}