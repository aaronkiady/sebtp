{% extends 'base.html.twig' %}

{% block title %}Nouvel organisme SEBTP{% endblock %}

{% block body %}
<div class="main-wrapper mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a href="{{ path('app_sebtp_index') }}" class="btn btn-outline-secondary btn-sm mb-3">
