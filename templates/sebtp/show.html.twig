{% extends 'base.html.twig' %}

{% block title %}Détails - {{ sebtp.nomOrganisme }}{% endblock %}

{% block body %}
<div class="main-wrapper mt-5">
    <div class="form-card-wide p-4">
        <div class="d-flex justify-content-between align-items-start mb-4">
            <div class="d-flex align-items-center">
                <a href="{{ path('app_sebtp_index') }}" class="btn btn-outline-secondary btn-sm shadow-sm me-3">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <div class="header-icon" style="background: var(--primary-light); color: var(--primary);">
                    <i class="fas fa-building"></i>
                </div>
                <div>
                    <h1 class="h2 fw-bold text-dark mb-0">{{ sebtp.nomOrganisme }}</h1>
                    <p class="text-muted mb-0">Détails de l'organisme SEBTP</p>
                </div>
            </div>
            <div class="d-flex gap-2">
                <a href="{{ path('app_sebtp_edit', {'id': sebtp.id}) }}" class="btn-action btn-cute text-decoration-none">
                    <i class="fas fa-pen"></i> Modifier
                </a>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-md-6">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h6 class="card-title text-muted mb-3">
                            <i class="fas fa-info-circle me-2"></i>Informations générales
                        </h6>
                        <div class="mb-3">
                            <label class="text-muted small">ID</label>
                            <div class="fw-bold">#{{ sebtp.id }}</div>
                        </div>
                        <div class="mb-3">
                            <label class="text-muted small">Instance</label>
                            <div class="fw-bold">
                                <i class="fas fa-tag me-2 text-primary"></i>
                                {{ sebtp.instance }}
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="text-muted small">Organisme</label>
                            <div class="fw-bold">
                                <i class="fas fa-building me-2 text-success"></i>
                                {{ sebtp.nomOrganisme }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h6 class="card-title text-muted mb-3">
                            <i class="fas fa-user-tie me-2"></i>Représentation
                        </h6>
                        <div class="mb-3">
                            <label class="text-muted small">Mandat</label>
                            <div class="fw-bold">
                                <i class="fas fa-calendar-alt me-2 text-warning"></i>
                                {{ sebtp.mandat }}
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="text-muted small">Nom du représentant</label>
                            <div class="fw-bold">
                                <i class="fas fa-user me-2 text-info"></i>
                                {{ sebtp.nomRepresentant }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 mt-4 pt-4 border-top">
    <h6 class="fw-bold mb-3">
        <i class="fas fa-paperclip me-2 text-primary"></i>
        Document(s) attaché(s)
    </h6>
    
    {% if sebtp.fichiers %}
        <div class="p-3 rounded-4" style="background: #f8fafc;">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <i class="fas fa-file-pdf text-danger fa-2x me-3"></i>
                    <span class="fw-bold">{{ sebtp.fichiers }}</span>
                </div>
                <div class="d-flex gap-2">
                    <a href="{{ path('app_liste_fichier_download', {'id': sebtp.id}) }}" class="btn btn-sm btn-success">
                        <i class="fas fa-download me-1"></i> Télécharger
                    </a>
                    {#<form method="post" action="{{ path('app_liste_fichier_delete', {'id': liste.id}) }}" onsubmit="return confirm('Supprimer ce fichier ?')">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_fichier_' ~ liste.id) }}">
                        <button type="submit" class="btn btn-sm btn-danger">
                            <i class="fas fa-trash me-1"></i> Supprimer
                        </button>
                    </form>#}
                </div>
            </div>
        </div>
    {% else %}
        <div class="text-muted">
            <i class="fas fa-info-circle me-1"></i> Aucun document attaché.
        </div>
    {% endif %}
</div>

            {% if sebtp.observation %}
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h6 class="card-title text-muted mb-3">
                            <i class="fas fa-comment me-2"></i>Observation
                        </h6>
                        <p class="mb-0">{{ sebtp.observation }}</p>
                    </div>
                </div>
            </div>
            {% endif %}
        </div>

        <div class="mt-5 pt-4 border-top d-flex justify-content-between align-items-center">
            <a href="{{ path('app_sebtp_index') }}" class="btn-action btn-cancel text-decoration-none">
                <i class="fas fa-arrow-left"></i> Retour à la liste
            </a>
            {{ include('sebtp/_delete_form.html.twig') }}
        </div>
    </div>
</div>
{% endblock %}