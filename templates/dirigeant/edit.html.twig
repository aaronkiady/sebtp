{% extends 'base.html.twig' %}

{% block title %}Modification des dirigeants{% endblock %}

{% block body %}
<div class="main-wrapper mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a href="{{ path('app_dirigeant_index') }}" class="btn btn-outline-secondary btn-sm mb-3">
                <i class="fas fa-arrow-left"></i> Retour à la liste
            </a>
            <h1 class="h2 fw-bold text-dark">Modifier les dirigeants</h1>
        </div>
    </div>

    <div class="form-card-wide mx-auto my-4">
        <div class="card-header-modern">
            <div class="header-icon">
                <i class="fas fa-edit"></i>
            </div>
            <div>
                <h4 class="mb-0 fw-800">Modification</h4>
                <p class="text-muted mb-0 small">Mettez à jour les informations du dirigeant</p>
            </div>
        </div>

        <div class="p-4 p-md-5">
            {{ include('dirigeant/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
        </div>
    </div>
</div>
{% endblock %}