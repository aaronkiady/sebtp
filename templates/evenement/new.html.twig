{% extends 'base.html.twig' %}

{% block title %}Nouvel Évènement{% endblock %}

{% block body %}
<div class="main-wrapper">
    <div class="form-card-wide">
        <div class="card-header-modern">
            <div class="header-icon" style="background: #ecfdf5; color: #10b981;">
                <i class="fas fa-calendar-plus"></i>
            </div>
            <div>
                <h4 class="mb-0 fw-800">Créer un évènement</h4>
                <p class="text-muted mb-0 small">Ajoutez une nouvelle activité à votre liste</p>
            </div>
        </div>

        <div class="p-4 p-md-5">
            {{ include('evenement/_form.html.twig', {'button_label': 'Créer maintenant'}) }}
        </div>
    </div>
</div>
{% endblock %}