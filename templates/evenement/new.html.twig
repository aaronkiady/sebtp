{% extends 'base.html.twig' %}

{% block title %}Nouvel événement{% endblock %}

{% block body %}
<div class="main-wrapper mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a href="{{ path('app_evenement_index') }}" class="btn btn-outline-secondary btn-sm mb-3">
                <i class="fas fa-arrow-left"></i> Retour à la liste
            </a>
            <h1 class="h2 fw-bold text-dark">Créer un nouvel événement</h1>
            <p class="text-muted">Remplissez les informations ci-dessous</p>
        </div>
    </div>

    {% for message in app.flashes('warning') %}
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>{{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}
    
    <div class="form-card-wide mx-auto my-4">
        <div class="card-header-modern">
            <div class="header-icon">
                <i class="fas fa-calendar-alt"></i>
            </div>
            <div>
                <h4 class="mb-0 fw-800">Informations de l'événement</h4>
                <p class="text-muted mb-0 small">Renseignez les détails de l'événement</p>
            </div>
        </div>

        <div class="p-4 p-md-5">
            <div class="row g-4">
                <div class="col-md-6">
                    <label class="form-label">
                        <i class="fas fa-tag me-2 opacity-50"></i>
                        {{ form.nom.vars.label }}
                    </label>
                    {{ form_widget(form.nom, {'attr': {'class': 'form-control custom-input'}}) }}
                    <div class="text-danger small mt-1">{{ form_errors(form.nom) }}</div>
                </div>

                <div class="col-md-6">
                    <label class="form-label">
                        <i class="fas fa-calendar-day me-2 opacity-50"></i>
                        {{ form.date.vars.label }}
                    </label>
                    {{ form_widget(form.date, {'attr': {'class': 'form-control custom-input'}}) }}
                    <div class="text-danger small mt-1">{{ form_errors(form.date) }}</div>
                </div>

                <div class="col-md-6">
                    <label class="form-label">
                        <i class="fas fa-money-bill-wave me-2 opacity-50"></i>
                        {{ form.montant.vars.label }}
                    </label>
                    {{ form_widget(form.montant, {'attr': {'class': 'form-control custom-input'}}) }}
                    <div class="text-danger small mt-1">{{ form_errors(form.montant) }}</div>
                </div>

                <div class="col-12">
                    <label class="form-label">
                        <i class="fas fa-comment me-2 opacity-50"></i>
                        {{ form.commentaire.vars.label }}
                    </label>
                    {{ form_widget(form.commentaire, {'attr': {'class': 'form-control custom-input'}}) }}
                    <div class="text-danger small mt-1">{{ form_errors(form.commentaire) }}</div>
                </div>

                {#<div class="col-12">
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>
                        <strong>Note:</strong> La sélection des participants est optionnelle. Vous pourrez ajouter des participants plus tard.
                    </div>
                    <label class="form-label fw-bold">
                        <i class="fas fa-users me-2 opacity-50"></i>
                        {{ form.participantsTemp.vars.label }} <span class="text-muted">(Optionnel)</span>
                    </label>
                    <div class="border rounded-3 p-3" style="max-height: 300px; overflow-y: auto;">
                        {{ form_widget(form.participantsTemp, {'attr': {'class': 'participants-checkbox-list'}}) }}
                    </div>
                    <small class="text-muted">Vous pouvez sélectionner des participants maintenant ou les ajouter ultérieurement.</small>
                    <div class="text-danger small mt-1">{{ form_errors(form.participantsTemp) }}</div>
                </div>#}
            </div>

            {{ form_rest(form) }}

            <div class="mt-5 pt-4 border-top d-flex justify-content-end gap-3">
                <a href="{{ path('app_evenement_index') }}" class="btn-action btn-cancel text-decoration-none">
                    <i class="fas fa-times me-2"></i> Annuler
                </a>
                <button type="submit" class="btn-action btn-update">
                    <i class="fas fa-save me-2"></i> Créer l'événement
                </button>
            </div>
        </div>
    </div>

    {{ form_end(form) }}
</div>

<style>
.participants-checkbox-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
}
.participants-checkbox-list label {
    margin-left: 10px;
    cursor: pointer;
}
.participants-checkbox-list input[type="checkbox"] {
    margin-right: 10px;
    cursor: pointer;
    transform: scale(1.1);
}
.participants-checkbox-list div {
    padding: 8px;
    border-radius: 8px;
    transition: background-color 0.2s;
}
.participants-checkbox-list div:hover {
    background-color: #f8f9fa;
}
</style>
{% endblock %}