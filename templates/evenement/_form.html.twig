{{ form_start(form) }}
    <div class="row g-4">
        <div class="col-md-12">
            <label class="form-label">Nom de l'évènement</label>
            {{ form_widget(form.nom, {'attr': {'class': 'form-control custom-input', 'placeholder': 'Ex: Réunion annuelle'}}) }}
        </div>
        <div class="col-md-6">
            <label class="form-label">Date</label>
            {{ form_widget(form.date, {'attr': {'class': 'form-control custom-input'}}) }}
        </div>
        <div class="col-md-6">
            <label class="form-label">Montant (MGA)</label>
            {{ form_widget(form.montant, {'attr': {'class': 'form-control custom-input', 'placeholder': '0'}}) }}
        </div>
        <div class="col-md-12">
            <label class="form-label">Commentaire</label>
            {{ form_widget(form.commentaire, {'attr': {'class': 'form-control custom-input', 'rows': '4'}}) }}
        </div>
    </div>

    <div class="mt-5 pt-4 border-top d-flex justify-content-end gap-3">
        <a href="{{ path('app_evenement_index') }}" class="btn-action btn-cancel text-decoration-none">Annuler</a>
        <button type="submit" class="btn-action btn-update">
            <i class="fas fa-save me-2"></i> {{ button_label|default('Enregistrer') }}
        </button>
    </div>
{{ form_end(form) }}