{% extends 'base.html.twig' %}

{% block title %}Gestion des Évènements{% endblock %}

{% block body %}
<div class="main-wrapper mt-5">
    <div class="form-card-wide p-4">
        <div class="d-flex justify-content-between align-items-start mb-4">
            <div class="d-flex align-items-center">
                <a href="{{ path('app_home') }}" class="btn btn-outline-secondary btn-sm shadow-sm me-3">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <div class="header-icon" style="background: var(--primary-light); color: var(--primary);">
                    <i class="fas fa-calendar-alt"></i>
                </div>
                
                <div>
                    <h1 class="h2 fw-bold text-dark mb-0">Évènements</h1>
                    <p class="text-muted mb-0">Liste et suivi des évènements de l'organisation</p>
                </div>
            </div>

            <div class="d-flex gap-2">
                <a href="{{ path('app_export_evenement_form') }}" class="btn btn-outline-success">
                    <i class="fas fa-file-excel me-2"></i>Exporter
                </a>
                <a href="{{ path('app_evenement_new') }}" class="btn btn-cute">
                    <i class="fas fa-plus me-2"></i>Nouvel évènement
                </a>
            </div>
        </div>

        <div class="px-2 mb-4">
            {{ include('_search_bar.html.twig') }}
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Id</th>
                        <th>Nom</th>
                        <th>Date</th>
                        <th>Montant unitaire</th>
                        <th>Participants</th>
                        <th>Commentaire</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for evenement in evenements %}
                    <tr>
                        <td class="text-muted">#{{ evenement.id }}</td>
                        <td>
                            <span class="fw-bold text-primary">{{ evenement.nom }}</span>
                        </td>
                        <td>
                            <i class="far fa-calendar-alt me-1 text-muted"></i>
                            {{ evenement.date ? evenement.date|date('d/m/Y') : 'Non définie' }}
                        </td>
                        <td class="fw-bold">
                            {{ evenement.montant ? evenement.montant|number_format(0, '.', ' ') ~ ' MGA' : '-' }}
                        </td>
                        <td>
                            <span class="badge bg-info rounded-pill">{{ evenement.participations|length }} participant(s)</span>
                        </td>
                        <td>
                            <span class="small text-muted">{{ evenement.commentaire|default('Aucun commentaire')|slice(0, 50) }}...</span>
                        </td>
                        <td class="text-end">
                            <div class="btn-group">
                                <a href="{{ path('app_evenement_show', {'id': evenement.id}) }}" 
                                   class="btn btn-sm btn-outline-secondary border-0 bg-light" 
                                   title="Voir">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="{{ path('app_evenement_edit', {'id': evenement.id}) }}" 
                                   class="btn btn-sm btn-outline-secondary border-0 bg-light ms-1" 
                                   title="Modifier">
                                    <i class="fas fa-edit"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="text-center py-5">
                            <div class="mb-3">
                                <img src="https://cdn-icons-png.flaticon.com/512/7486/7486744.png" width="60" class="opacity-25" alt="aucun résultat">
                            </div>
                            <p class="text-muted fw-bold">Aucun évènement enregistré.</p>
                            <a href="{{ path('app_evenement_new') }}" class="btn btn-primary mt-2">
                                <i class="fas fa-plus me-2"></i>Créer un événement
                            </a>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}