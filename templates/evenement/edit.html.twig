{% extends 'base.html.twig' %}

{% block title %}Modifier l'Évènement{% endblock %}

{% block body %}
<div class="main-wrapper">
    <div class="form-card-wide">
        <div class="card-header-modern">
            <div class="header-icon" style="background: #fff7ed; color: #f97316;">
                <i class="fas fa-pen-fancy"></i>
            </div>
            <div>
                <h4 class="mb-0 fw-800">Modifier l'évènement</h4>
                <p class="text-muted mb-0 small">Mise à jour des informations de l'évènement #{{ evenement.id }}</p>
            </div>
        </div>

        <div class="p-4 p-md-5">
            {{ include('evenement/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
            
            {#<div class="mt-4 pt-3 border-top d-flex justify-content-between align-items-center">
                <span class="text-muted small italic">Action irréversible :</span>
                {{ include('evenement/_delete_form.html.twig') }}
            </div>#}
        </div>
    </div>
</div>
{% endblock %}