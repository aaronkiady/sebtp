{% extends 'base.html.twig' %}

{% block title %}Gérer les participants - {{ evenement.nom }}{% endblock %}

{% block body %}
<div class="main-wrapper mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a href="{{ path('app_evenement_show', {'id': evenement.id}) }}" class="btn btn-outline-secondary btn-sm mb-3">
                <i class="fas fa-arrow-left"></i> Retour à l'événement
            </a>
            <h1 class="h2 fw-bold text-dark">Gérer les participants</h1>
            <p class="text-muted">{{ evenement.nom }}</p>
        </div>
    </div>

    {{ form_start(form) }}
    <div class="form-card-wide mx-auto my-4">
        <div class="card-header-modern">
            <div class="header-icon">
                <i class="fas fa-users"></i>
            </div>
            <div>
                <h4 class="mb-0 fw-800">Sélection des participants</h4>
                <p class="text-muted mb-0 small">Cochez les participants à inscrire à cet événement</p>
            </div>
        </div>

        <div class="p-4 p-md-5">
            <div class="alert alert-info">
                <i class="fas fa-info-circle me-2"></i>
                <strong>Information:</strong> Cochez les participants que vous souhaitez inscrire. Les participants décochés seront retirés de l'événement.
            </div>

            <div class="border rounded-3 p-3" style="max-height: 500px; overflow-y: auto;">
                {{ form_widget(form.participants, {'attr': {'class': 'participants-checkbox-list'}}) }}
            </div>

            <div class="mt-5 pt-4 border-top d-flex justify-content-end gap-3">
                <a href="{{ path('app_evenement_show', {'id': evenement.id}) }}" class="btn-action btn-cancel text-decoration-none">
                    <i class="fas fa-times me-2"></i> Annuler
                </a>
                <button type="submit" class="btn-action btn-update">
                    <i class="fas fa-save me-2"></i> Enregistrer les modifications
                </button>
            </div>
        </div>
    </div>
    {{ form_end(form) }}
</div>

<style>
.participants-checkbox-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
}
.participants-checkbox-list label {
    margin-left: 10px;
    cursor: pointer;
}
.participants-checkbox-list input[type="checkbox"] {
    margin-right: 10px;
    cursor: pointer;
    transform: scale(1.1);
}
.participants-checkbox-list div {
    padding: 10px;
    border-radius: 8px;
    transition: background-color 0.2s;
}
.participants-checkbox-list div:hover {
    background-color: #f8f9fa;
}
</style>
{% endblock %}