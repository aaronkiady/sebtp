{% extends 'base.html.twig' %}

{% block title %}Événements de {{ adherent.nom }}{% endblock %}

{% block body %}
<div class="container mt-5">
    {# Header #}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800">Participation Événementielle</h1>
            <p class="text-muted">Historique pour l'adhérent <strong>{{ adherent.nom }}</strong></p>
        </div>
        <a href="{{ path('app_liste_show', {'id': adherent.id}) }}" class="btn btn-outline-secondary shadow-sm">
            <i class="fas fa-arrow-left"></i> Retour à la fiche
        </a>
    </div>

    {# Stats Card #}
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Total participations</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">{{ evenements|length }}</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-calendar-check fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Table Card #}
    <div class="card shadow mb-4">
        <div class="card-header py-3 bg-white">
            <h6 class="m-0 font-weight-bold text-primary">Liste des événements fréquentés</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover" width="100%" cellspacing="0">
                    <thead class="table-light">
                        <tr>
                            <th>Nom de l'événement</th>
                            <th>Date</th>
                            <th>Frais / Montant</th>
                            <th>Notes</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for evenement in evenements %}
                        <tr>
                            <td class="align-middle fw-bold text-dark">{{ evenement.nom }}</td>
                            <td class="align-middle">{{ evenement.date ? evenement.date|date('d/m/Y') : '-' }}</td>
                            <td class="align-middle">
                                <span class="badge bg-light text-primary border">
                                    {{ evenement.montant ? evenement.montant ~ ' MGA' : 'Gratuit' }}
                                </span>
                            </td>
                            <td class="align-middle small text-muted">
                                {{ evenement.commentaire|default('Aucune note') }}
                            </td>
                            <td class="align-middle text-center">
                                <a href="{{ path('app_evenement_show', {'id': evenement.id}) }}" class="btn btn-sm btn-outline-primary shadow-sm">
                                    <i class="fas fa-eye"></i>
                                </a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="fas fa-calendar-times fa-3x mb-3 d-block opacity-25"></i>
                                Aucun événement enregistré pour cet adhérent.
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .border-left-info { border-left: 0.25rem solid #36b9cc !important; }
        .text-xs { font-size: .75rem; text-transform: uppercase; }
        .table-hover tbody tr:hover { background-color: rgba(0,0,0,.02); }
    </style>
{% endblock %}