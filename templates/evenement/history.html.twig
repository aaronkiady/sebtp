{% extends 'base.html.twig' %}

{% block title %}Historique des événements - {{ adherent.nom }}{% endblock %}

{% block body %}
<div class="main-wrapper mt-5">
    <div class="form-card-wide p-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <a href="{{ path('app_liste_show', {'id': adherent.id}) }}" class="btn btn-outline-secondary btn-sm mb-3">
                    <i class="fas fa-arrow-left"></i> Retour
                </a>
                <h2 class="fw-bold text-dark">Historique des événements</h2>
                <p class="text-muted">{{ adherent.nom }}</p>
            </div>
        </div>

        {#{% for message in app.flashes('success') %}
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle me-2"></i>{{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}#}

        {% if adherent.statut == 'radie' %}
            <div class="alert alert-warning">
                <i class="fas fa-exclamation-triangle me-2"></i>
                <strong>Adhérent radié :</strong> Cet adhérent a été radié. L'historique des événements n'est pas disponible.
            </div>
        {% elseif participations|length > 0 %}
            {# Affichage du tableau des participations #}
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Événement</th>
                            <th>Date</th>
                            <th>Montant (MGA)</th>
                            <th>Statut de paiement</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for participation in participations %}
                            {% set evenement = participation.evenement %}
                            <tr>
                                <td class="fw-bold">{{ evenement.nom }}</td>
                                <td>
                                    <i class="far fa-calendar-alt me-1 text-muted"></i>
                                    {{ evenement.date ? evenement.date|date('d/m/Y') : 'Date non définie' }}
                                </td>
                                <td class="fw-bold">
                                    {{ evenement.montant ? evenement.montant|number_format(0, '.', ' ') : '0' }} MGA
                                </td>
                                <td>
                                    {% if participation.statutPaiement == 'paye' %}
                                        <span class="badge bg-success rounded-pill px-3 py-2">
                                            <i class="fas fa-check-circle me-1"></i> Payé
                                        </span>
                                    {% else %}
                                        <span class="badge bg-danger rounded-pill px-3 py-2">
                                            <i class="fas fa-times-circle me-1"></i> Impayé
                                        </span>
                                    {% endif %}
                                </td>
                                <td>
                                    <a href="{{ path('app_participation_toggle', {'id': participation.id}) }}" 
                                       class="btn btn-sm {% if participation.statutPaiement == 'paye' %}btn-warning{% else %}btn-success{% endif %}"
                                       onclick="return confirm('Confirmer le changement de statut ?')">
                                        <i class="fas {% if participation.statutPaiement == 'paye' %}fa-undo{% else %}fa-check{% endif %} me-1"></i>
                                        {% if participation.statutPaiement == 'paye' %}Marquer impayé{% else %}Marquer payé{% endif %}
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <div class="text-center py-5">
                <div class="mb-3">
                    <i class="fas fa-calendar-times fa-4x text-muted opacity-25"></i>
                </div>
                <p class="text-muted fw-bold">Aucun événement enregistré pour cet adhérent.</p>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}