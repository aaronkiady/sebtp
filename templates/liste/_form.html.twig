{{ form_start(form) }}
    <div class="form-card-wide mx-auto my-4">
        <div class="card-header-modern">
            <div class="header-icon">
                <i class="fas fa-id-card"></i>
            </div>
            <div>
                <h4 class="mb-0 fw-800">Informations de l'adhérent</h4>
                <p class="text-muted mb-0 small">Renseignez les détails professionnels du membre</p>
            </div>
        </div>

        <div class="p-4 p-md-5" id="form-content">
            <div class="row g-4">

                {# Macro pour éviter la répétition #}
                {% macro render_field(field, icon, icon_class, hint, required_override) %}
                    <div class="col-md-6">
                        <label class="form-label">
                            <i class="{{ icon }} me-2 opacity-50 {{ icon_class|default('') }}"></i>
                            {{ field.vars.label|default(field.vars.name|capitalize) }}
                            {% if field.vars.required %}
                                <span class="text-danger">*</span>
                            {% endif %}
                        </label>
                        {{ form_widget(field, {'attr': {'class': 'form-control custom-input'}}) }}
                        <div class="text-danger small mt-1">{{ form_errors(field) }}</div>
                        {% if hint %}
                            <small class="text-muted">{{ hint }}</small>
                        {% endif %}
                    </div>
                {% endmacro %}

                {# Macro spéciale pour les champs avec cases à cocher (expanded + multiple) #}
                {% macro render_checkbox_field(field, icon, icon_class, hint) %}
                    <div class="col-md-12">
                        <label class="form-label">
                            <i class="{{ icon }} me-2 opacity-50 {{ icon_class|default('') }}"></i>
                            {{ field.vars.label|default(field.vars.name|capitalize) }}
                            {% if field.vars.required %}
                                <span class="text-danger">*</span>
                            {% endif %}
                        </label>
                        <div class="border rounded-3 p-3" style="max-height: 200px; overflow-y: auto;">
                            {{ form_widget(field, {'attr': {'class': 'filiere-checkbox-list'}}) }}
                        </div>
                        <div class="text-danger small mt-1">{{ form_errors(field) }}</div>
                        {% if hint %}
                            <small class="text-muted">{{ hint }}</small>
                        {% endif %}
                    </div>
                {% endmacro %}

                {% import _self as f %}

                {{ f.render_field(form.nom,          'fas fa-building',          '') }}
                {{ f.render_field(form.adresse,       'fas fa-map-marker-alt',    '') }}
                {{ f.render_field(form.numero,        'fas fa-phone',             '') }}
                {{ f.render_field(form.email,         'fas fa-envelope',          '') }}
                {{ f.render_field(form.statut,        'fas fa-tag',               '') }}
                {{ f.render_field(form.nif,                                       '') }}
                {{ f.render_field(form.stat,                                      '') }}
                {{ f.render_field(form.cnaps,                                     '') }}

                {# Champs conditionnels liés au statut principal #}
                {% if form.validationBureau is defined %}
                    {{ f.render_field(form.validationBureau, 'fas fa-building', 'text-primary', 'Date à laquelle le bureau a validé l\'adhésion') }}
                {% endif %}
                {% if form.validationAG is defined %}
                    {{ f.render_field(form.validationAG, 'fas fa-users', 'text-success', 'Date à laquelle l\'AG a validé l\'adhésion') }}
                {% endif %}
                {% if form.raisonDepart is defined %}
                    <div class="col-md-12">
                        <label class="form-label">
                            <i class="fas fa-sign-out-alt me-2 opacity-50 text-danger"></i>
                            {{ form.raisonDepart.vars.label }}
                            <span class="text-danger">*</span>
                        </label>
                        {{ form_widget(form.raisonDepart, {'attr': {'class': 'form-control custom-input', 'rows': 3}}) }}
                        <div class="text-danger small mt-1">{{ form_errors(form.raisonDepart) }}</div>
                        <small class="text-muted">Requis en cas de départ</small>
                    </div>
                {% endif %}
                {% if form.statutDemande is defined %}
                    {{ f.render_field(form.statutDemande, 'fas fa-clock', 'text-warning', 'Suivi du processus d\'adhésion') }}
                {% endif %}

                {{ f.render_field(form.type,          'fas fa-briefcase',             '') }}
                {{ f.render_field(form.siteWeb,       'fas fa-globe',             '') }}
                {{ f.render_field(form.activite,      'fas fa-briefcase',         '') }}
                
                {# Champ filière avec cases à cocher #}
                {{ f.render_checkbox_field(form.filiere, 'fas fa-chart-line', '', 'Sélectionnez une ou plusieurs filières') }}
                
                {{ f.render_field(form.nbEmployes,    'fas fa-users',             '') }}
                {{ f.render_field(form.cotFMTP,       'fas fa-hand-holding-usd',  '') }}
                {{ f.render_field(form.dg,            'fas fa-user-tie',          '') }}
                {{ f.render_field(form.adresseDg,     'fas fa-envelope',           '') }}
                {{ f.render_field(form.telephoneDg,   'fas fa-phone-alt',         '') }}
                {{ f.render_field(form.referentSebtp,                             '') }}
                {{ f.render_field(form.numRef,                                    '') }}
                {{ f.render_field(form.mailRef,                                   '') }}
                {{ f.render_field(form.statutMenmbre, 'fas fa-id-badge',          '') }}

                {# Champs conditionnels liés au statut membre #}
                {% if form.fonctionSEBTP is defined %}
                    {{ f.render_field(form.fonctionSEBTP, 'fas fa-user-tie', 'text-info') }}
                {% endif %}
                {% if form.mandat is defined %}
                    {{ f.render_field(form.mandat, 'fas fa-calendar-alt', 'text-info') }}
                {% endif %}

                {{ f.render_field(form.observation,   'fas fa-comment',           '') }}
                
                {# Champ fichier - affiché séparément car c'est un FileType #}
                <div class="col-md-12">
                    <label class="form-label">
                        <i class="fas fa-paperclip me-2 opacity-50"></i>
                        {{ form.fichiers.vars.label|default('Document') }}
                    </label>
                    {{ form_widget(form.fichiers, {'attr': {'class': 'form-control custom-input'}}) }}
                    <div class="text-danger small mt-1">{{ form_errors(form.fichiers) }}</div>
                    <small class="text-muted">Formats acceptés : PDF, DOC, DOCX (max 10 Mo)</small>
                </div>

                {# SECTION CONTACTS - Collection de contacts #}
                <div class="col-12 mt-4">
                    <div class="card border">
                        <div class="card-header bg-white d-flex justify-content-between align-items-center">
                            <h6 class="fw-bold mb-0">
                                <i class="fas fa-address-book me-2 text-primary"></i>
                                Contacts
                            </h6>
                            <button type="button" class="btn btn-sm btn-success" id="add-contact">
                                <i class="fas fa-plus me-1"></i> Ajouter un contact
                            </button>
                        </div>
                        <div class="card-body">
                            <div id="contacts-wrapper" data-prototype="{{ form_widget(form.contacts.vars.prototype)|e('html_attr') }}">
                                {% for contact in form.contacts %}
                                    <div class="contact-item border-bottom pb-3 mb-3">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div class="row g-3 flex-grow-1">
                                                <div class="col-md-3">
                                                    <label class="form-label small">Nom</label>
                                                    {{ form_widget(contact.nom, {'attr': {'class': 'form-control form-control-sm'}}) }}
                                                </div>
                                                <div class="col-md-3">
                                                    <label class="form-label small">Fonction</label>
                                                    {{ form_widget(contact.fonction, {'attr': {'class': 'form-control form-control-sm'}}) }}
                                                </div>
                                                <div class="col-md-3">
                                                    <label class="form-label small">Email</label>
                                                    {{ form_widget(contact.email, {'attr': {'class': 'form-control form-control-sm'}}) }}
                                                </div>
                                                <div class="col-md-3">
                                                    <label class="form-label small">Téléphone</label>
                                                    {{ form_widget(contact.telephone, {'attr': {'class': 'form-control form-control-sm'}}) }}
                                                </div>
                                            </div>
                                            <button type="button" class="btn btn-sm btn-outline-danger ms-2 remove-contact" title="Supprimer ce contact">
                                                <i class="fas fa-times"></i>
                                            </button>
                                        </div>
                                        {{ form_errors(contact) }}
                                    </div>
                                {% endfor %}
                            </div>
                            <small class="text-muted">Ajoutez les contacts (RH, Compta, etc.) pour cet adhérent</small>
                        </div>
                    </div>
                </div>

            </div>

            {{ form_rest(form) }}

            <div class="mt-5 pt-4 border-top d-flex justify-content-end gap-3">
                <a href="{{ path('app_liste_index') }}" class="btn-action btn-cancel text-decoration-none">
                    <i class="fas fa-times me-2"></i> Annuler
                </a>
                <button type="submit" class="btn-action btn-update">
                    <i class="fas fa-save me-2"></i> {{ button_label|default('Enregistrer') }}
                </button>
            </div>
        </div>
    </div>
{{ form_end(form) }}

<script>
function refreshFormContent(formElement) {
    let data = new FormData(formElement);
    
    fetch(formElement.action || window.location.href, {
        method: 'POST',
        body: data,
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(response => response.text())
    .then(html => {
        let parser = new DOMParser();
        let doc = parser.parseFromString(html, 'text/html');
        let newContent = doc.getElementById('form-content');
        if (newContent) {
            document.getElementById('form-content').innerHTML = newContent.innerHTML;
            attachFormEvents();
        }
    })
    .catch(error => console.error('Erreur:', error));
}

function attachFormEvents() {
    const statutSelect = document.getElementById('liste_statut');
    const statutMenmbreSelect = document.getElementById('liste_statutMenmbre');
    
    if (statutSelect) {
        statutSelect.removeEventListener('change', handleStatutChange);
        statutSelect.addEventListener('change', handleStatutChange);
    }
    
    if (statutMenmbreSelect) {
        statutMenmbreSelect.removeEventListener('change', handleStatutMenmbreChange);
        statutMenmbreSelect.addEventListener('change', handleStatutMenmbreChange);
    }
    
    // Gestion des contacts
    const contactsWrapper = document.getElementById('contacts-wrapper');
    const addContactBtn = document.getElementById('add-contact');
    
    if (addContactBtn && contactsWrapper) {
        // Supprimer les anciens écouteurs
        const newAddBtn = addContactBtn.cloneNode(true);
        addContactBtn.parentNode.replaceChild(newAddBtn, addContactBtn);
        
        newAddBtn.addEventListener('click', function(e) {
            e.preventDefault();
            const prototype = contactsWrapper.dataset.prototype;
            const index = contactsWrapper.querySelectorAll('.contact-item').length;
            const newForm = prototype.replace(/__name__/g, index);
            
            const div = document.createElement('div');
            div.className = 'contact-item border-bottom pb-3 mb-3';
            div.innerHTML = newForm;
            
            // Ajouter le bouton supprimer
            const headerDiv = div.querySelector('.d-flex');
            if (headerDiv) {
                const removeBtn = document.createElement('button');
                removeBtn.type = 'button';
                removeBtn.className = 'btn btn-sm btn-outline-danger ms-2 remove-contact';
                removeBtn.title = 'Supprimer ce contact';
                removeBtn.innerHTML = '<i class="fas fa-times"></i>';
                headerDiv.appendChild(removeBtn);
                
                removeBtn.addEventListener('click', function() {
                    div.remove();
                });
            }
            
            contactsWrapper.appendChild(div);
        });
    }
    
    // Gestion de la suppression des contacts existants
    document.querySelectorAll('.remove-contact').forEach(function(btn) {
        btn.addEventListener('click', function() {
            const contactItem = this.closest('.contact-item');
            if (contactItem) {
                contactItem.remove();
            }
        });
    });
}

function handleStatutChange(e) {
    refreshFormContent(e.target.closest('form'));
}

function handleStatutMenmbreChange(e) {
    refreshFormContent(e.target.closest('form'));
}

document.addEventListener('DOMContentLoaded', attachFormEvents);
</script>

<style>
.custom-input:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 0.2rem rgba(79, 70, 229, 0.25);
}
textarea.custom-input {
    resize: vertical;
}

/* Style pour les cases à cocher de la filière */
.filiere-checkbox-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
}
.filiere-checkbox-list label {
    margin-left: 10px;
    cursor: pointer;
    font-weight: normal;
}
.filiere-checkbox-list input[type="checkbox"] {
    margin-right: 10px;
    cursor: pointer;
    transform: scale(1.1);
}
.filiere-checkbox-list div {
    padding: 10px;
    border-radius: 8px;
    transition: background-color 0.2s;
}
.filiere-checkbox-list div:hover {
    background-color: #f8f9fa;
}

/* Style pour les contacts */
.contact-item {
    transition: background-color 0.2s;
}
.contact-item:hover {
    background-color: #f8fafc;
}
</style>