{{ form_start(form) }}
    <div class="form-card-wide mx-auto my-4">
        <div class="card-header-modern">
            <div class="header-icon">
                <i class="fas fa-id-card"></i>
            </div>
            <div>
                <h4 class="mb-0 fw-800">Informations de l'adhérent</h4>
                <p class="text-muted mb-0 small">Renseignez les détails professionnels du membre</p>
            </div>
        </div>

        <div class="p-4 p-md-5" id="form-content">
            <div class="row g-4">
                {% for field in form %}
                    {% if field.vars.name != '_token' %}
                        <div class="col-md-6">
                            <label class="form-label">
                                {% if 'nom' in field.vars.name %}<i class="fas fa-building me-2 opacity-50"></i>
                                {% elseif 'email' in field.vars.name %}<i class="fas fa-envelope me-2 opacity-50"></i>
                                {% elseif 'numero' in field.vars.name %}<i class="fas fa-phone me-2 opacity-50"></i>
                                {% elseif 'adresse' in field.vars.name %}<i class="fas fa-map-marker-alt me-2 opacity-50"></i>
                                {% elseif 'statut' in field.vars.name %}<i class="fas fa-tag me-2 opacity-50"></i>
                                {% else %}<i class="fas fa-circle-info me-2 opacity-50"></i>
                                {% endif %}
                                {{ field.vars.label|default(field.vars.name|capitalize) }}
                            </label>
                            
                            {{ form_widget(field, {'attr': {'class': 'form-control custom-input'}}) }}
                            <div class="text-danger small mt-1">{{ form_errors(field) }}</div>
                        </div>
                    {% endif %}
                {% endfor %}
            </div>

            {{ form_rest(form) }}

            <div class="mt-5 pt-4 border-top d-flex justify-content-end gap-3">
                <a href="{{ path('app_liste_index') }}" class="btn-action btn-cancel text-decoration-none">
                    <i class="fas fa-times me-2"></i> Annuler
                </a>
                <button type="submit" class="btn-action btn-update">
                    <i class="fas fa-save me-2"></i> {{ button_label|default('Enregistrer') }}
                </button>
            </div>
        </div>
    </div>
{{ form_end(form) }}

<script>
/**
 * Gestion du rechargement AJAX pour les champs dynamiques (Bureau/Simple membre)
 */
document.addEventListener('change', function (e) {
    if (e.target.id === 'liste_statutMenmbre') {
        let formElement = e.target.closest('form');
        let data = new FormData(formElement);

        fetch(formElement.action || window.location.href, {
            method: 'POST',
            body: data,
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(response => response.text())
        .then(html => {
            let parser = new DOMParser();
            let doc = parser.parseFromString(html, 'text/html');
            let newContent = doc.getElementById('form-content');
            if (newContent) {
                document.getElementById('form-content').innerHTML = newContent.innerHTML;
            }
        });
    }
});
</script>