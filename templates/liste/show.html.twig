{% extends 'base.html.twig' %}

{% block title %}Détails de {{ liste.nom }}{% endblock %}

{% block body %}
<div class="main-wrapper">
    <div class="form-card-wide">
        {# En-tête de profil #}
        <div class="card-header-modern justify-content-between">
            <div class="d-flex align-items-center">
                <div class="header-icon" style="background: var(--primary); color: white; font-weight: 800; font-size: 1.5rem;">
                    {{ liste.nom|first|upper }}
                </div>
                <div>
                    <h2 class="h3 fw-bold mb-0 text-dark">{{ liste.nom }}</h2>
                    <span class="badge {{ liste.statutMenmbre == 'bureau' ? 'bg-primary-light text-primary' : 'bg-light text-muted' }} rounded-pill px-3">
                        {{ liste.statutMenmbre == 'bureau' ? 'Membre du Bureau' : 'Simple Membre' }}
                    </span>
                </div>
            </div>
            <div class="d-flex gap-2">
                {#<a href="{{ path('app_liste_stats', {'id': liste.id}) }}" class="btn-action btn-cute text-decoration-none" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
                    <i class="fas fa-chart-line me-1"></i> Statistiques
                </a>#}
                <a href="{{ path('app_liste_edit', {'id': liste.id}) }}" class="btn-action btn-cute text-decoration-none">
                    <i class="fas fa-pen"></i> Modifier
                </a>
            </div>
        </div>

        <div class="p-4 p-md-5">
            {# Section Historiques / Actions rapides #}
            <div class="mb-5">
                <h6 class="text-uppercase fw-bold text-muted small mb-3" style="letter-spacing: 1px;">Gestion et Suivi</h6>
                <div class="d-flex flex-wrap gap-3">
                    <a href="{{ path('app_cotisation_history', {'adherent_id': liste.id}) }}" class="btn-action btn-cancel text-decoration-none border shadow-sm">
                        <i class="fas fa-file-invoice-dollar text-primary"></i> Cotisations
                    </a>
                    <a href="{{ path('app_formation_history', {'adherent_id': liste.id}) }}" class="btn-action btn-cancel text-decoration-none border shadow-sm">
                        <i class="fas fa-graduation-cap text-success"></i> Formations
                    </a>
                    <a href="{{ path('app_evenement_history', {'adherent_id': liste.id}) }}" class="btn-action btn-cancel text-decoration-none border shadow-sm">
                        <i class="fas fa-calendar-star text-warning"></i> Événements
                    </a>
                    <a href="{{ path('app_liste_contacts_interne', {'id': liste.id}) }}" class="btn-action btn-cancel text-decoration-none border shadow-sm">
                        <i class="fas fa-address-book text-info"></i> Contacts Internes
                    </a>
                </div>
            </div>

            {# Grille d'informations #}
            <div class="row g-4">
                <div class="col-md-6 col-lg-4">
                    <label class="form-label text-uppercase opacity-50 small">Contact</label>
                    <div class="fw-bold"><i class="fas fa-phone me-2 text-muted"></i>{{ liste.numero }}</div>
                    <div class="text-primary mt-1"><i class="fas fa-envelope me-2 text-muted"></i>{{ liste.email }}</div>
                </div>
                <div class="col-md-6 col-lg-4">
                    <label class="form-label text-uppercase opacity-50 small">Localisation</label>
                    <div class="fw-bold"><i class="fas fa-map-marker-alt me-2 text-muted"></i>{{ liste.adresse }}</div>
                    <div class="text-muted mt-1"><i class="fas fa-globe me-2"></i>{{ liste.siteWeb|default('N/A') }}</div>
                </div>
                <div class="col-md-6 col-lg-4">
                    <label class="form-label text-uppercase opacity-50 small">Activité</label>
                    <div class="fw-bold text-dark">{{ liste.activite }}</div>
                    <div class="badge bg-light text-dark mt-1">{{ liste.filiere }}</div>
                </div>
                
                <div class="col-12 mt-4 p-4 rounded-4" style="background: #f8fafc;">
                    <div class="row g-4">
                        <div class="col-md-4">
                            <span class="d-block text-muted small">Employés</span>
                            <span class="fw-bold">{{ liste.nbEmployes }}</span>
                        </div>
                        <div class="col-md-4">
                            <span class="d-block text-muted small">Statut Juridique</span>
                            <span class="fw-bold text-uppercase">{{ liste.statut }}</span>
                        </div>
                        <div class="col-md-4">
                            <span class="d-block text-muted small">Cotisation FMFP</span>
                            <span class="fw-bold">{{ liste.cotFMTP }}</span>
                        </div>
                    </div>
                </div>

                {# Section Direction #}
                <div class="col-12 mt-4 pt-4 border-top">
                    <h6 class="fw-bold mb-3"><i class="fas fa-user-tie me-2 text-primary"></i>Direction Générale</h6>
                    <div class="row">
                        <div class="col-md-4"><strong>{{ liste.dg }}</strong><br><span class="text-muted small">Directeur Général</span></div>
                        <div class="col-md-4"><i class="fas fa-phone-alt me-2 small opacity-50"></i>{{ liste.telephoneDg }}</div>
                        <div class="col-md-4"><i class="fas fa-map me-2 small opacity-50"></i>{{ liste.adresseDg }}</div>
                    </div>
                </div>

                {% if liste.statutMenmbre == 'bureau' %}
                <div class="col-12 mt-4 pt-4 border-top">
                    <div class="p-3 rounded-4" style="background: linear-gradient(to right, #eef2ff, #fdf2f8);">
                        <h6 class="fw-bold text-primary mb-2">Responsabilités SEBTP</h6>
                        <div class="d-flex gap-5">
                            <div><span class="text-muted small">Fonction:</span> <span class="fw-bold">{{ liste.fonctionSEBTP }}</span></div>
                            <div><span class="text-muted small">Mandat:</span> <span class="fw-bold">{{ liste.mandat }}</span></div>
                        </div>
                    </div>
                </div>
                {% endif %}
<div class="col-12 mt-4 pt-4 border-top">
    <h6 class="fw-bold mb-3">
        <i class="fas fa-paperclip me-2 text-primary"></i>
        Document(s) attaché(s)
    </h6>
    
    {% if liste.fichiers %}
        <div class="p-3 rounded-4" style="background: #f8fafc;">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <i class="fas fa-file-pdf text-danger fa-2x me-3"></i>
                    <span class="fw-bold">{{ liste.fichiers }}</span>
                </div>
                <div class="d-flex gap-2">
                    <a href="{{ path('app_liste_fichier_download', {'id': liste.id}) }}" class="btn btn-sm btn-success">
                        <i class="fas fa-download me-1"></i> Télécharger
                    </a>
                    {#<form method="post" action="{{ path('app_liste_fichier_delete', {'id': liste.id}) }}" onsubmit="return confirm('Supprimer ce fichier ?')">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_fichier_' ~ liste.id) }}">
                        <button type="submit" class="btn btn-sm btn-danger">
                            <i class="fas fa-trash me-1"></i> Supprimer
                        </button>
                    </form>#}
                </div>
            </div>
        </div>
    {% else %}
        <div class="text-muted">
            <i class="fas fa-info-circle me-1"></i> Aucun document attaché.
        </div>
    {% endif %}
</div>
            </div>
            <div class="mt-5 pt-4 border-top d-flex justify-content-between align-items-center">
                <a href="{{ path('app_liste_index') }}" class="btn-action btn-cancel text-decoration-none">
                    <i class="fas fa-arrow-left"></i> Liste des membres
                </a>
                {{ include('liste/_delete_form.html.twig') }}
            </div>
        </div>
    </div>
</div>
{% endblock %}