{% extends 'base.html.twig' %}

{% block title %}Annuaire des adhérents{% endblock %}

{% block body %}
<div class="main-wrapper mt-5">
    <div class="form-card-wide p-4">
        <div class="d-flex justify-content-between align-items-start mb-4">
            <div class="d-flex align-items-center">
                <a href="{{ path('app_home') }}" class="btn btn-outline-secondary btn-sm shadow-sm me-3">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <div class="header-icon" style="background: var(--primary-light); color: var(--primary);">
                    <i class="fas fa-users"></i>
                </div>
                <div>
                    <h1 class="h2 fw-bold text-dark mb-0">Annuaire des adhérents</h1>
                    <p class="text-muted mb-0">Gestion et suivi des membres</p>
                </div>
            </div>
            <div class="d-flex gap-2">
                <a href="{{ path('app_liste_import') }}?{{ app.request.query.all|url_encode }}" class="btn btn-outline-success">
                    <i class="fas fa-file-excel me-2"></i>Importer
                </a>
                <a href="{{ path('app_export_liste_form') }}?{{ app.request.query.all|url_encode }}" class="btn btn-outline-success">
                    <i class="fas fa-file-excel me-2"></i>Exporter
                </a>
                <a href="{{ path('app_liste_new') }}" class="btn btn-cute">
                    <i class="fas fa-plus me-2"></i>Ajouter adhérent
                </a>
            </div>
        </div>

        {# Barre de recherche et filtres #}
        <form method="get" action="{{ path('app_liste_index') }}">
                    <div class="row g-3 mb-4">

                        <div class="col-md-4">
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">
                                    <i class="fas fa-search text-muted" style="font-size: 13px;"></i>
                                </span>
                                <input type="text" name="q" class="form-control border-start-0 ps-0"
                                    placeholder="Nom, email, téléphone..."
                                    value="{{ searchTerm }}">
                            </div>
                        </div>

                        <div class="col-md-2">
                            <select name="statut" class="form-select">
                                <option value="">Tous les statuts</option>
                                <option value="actif"    {% if statut == 'actif'    %}selected{% endif %}>✅ Actif</option>
                                <option value="inactif"  {% if statut == 'inactif'  %}selected{% endif %}>⚠️ Inactif</option>
                                <option value="radie"    {% if statut == 'radie'    %}selected{% endif %}>🚫 Radié</option>
                                <option value="demande"  {% if statut == 'demande'  %}selected{% endif %}>🕐 Demande</option>
                            </select>
                        </div>

                        <div class="col-md-2">
                            <select name="filiere" class="form-select">
                                <option value="">Toutes les filières</option>
                                {% for fil in filieres %}
                                    <option value="{{ fil }}" {% if filiere == fil %}selected{% endif %}>{{ fil }}</option>
                                {% endfor %}
                            </select>
                        </div>

                        <div class="col-md-2">
                            <select name="cotFMTP" class="form-select">
                                <option value="">Cotisation FMFP</option>
                                <option value="Oui" {% if cotFMTP == 'Oui' %}selected{% endif %}>Oui</option>
                                <option value="Non" {% if cotFMTP == 'Non' %}selected{% endif %}>Non</option>
                            </select>
                        </div>

                        <div class="col-md-2">
                            <select name="statutMenmbre" class="form-select">
                                <option value="">Statut membre</option>
                                <option value="simple" {% if statutMenmbre == 'simple' %}selected{% endif %}>Simple membre</option>
                                <option value="bureau" {% if statutMenmbre == 'bureau' %}selected{% endif %}>Membre du bureau</option>
                            </select>
                        </div>

                        <div class="col-md-2">
                            <select name="type" class="form-select">
                                <option value="">Tous types</option>
                                <option value="ong"        {% if type == 'ong'        %}selected{% endif %}>ONG</option>
                                <option value="entreprise" {% if type == 'entreprise' %}selected{% endif %}>Entreprise</option>
                                <option value="sponsor"    {% if type == 'sponsor'    %}selected{% endif %}>Sponsor</option>
                            </select>
                        </div>

                        {#<div class="col-md-2">
                            <select name="anneeAdhesion" class="form-select">
                                <option value="">Année adhésion</option>
                                {% for year in adhesionYears %}
                                    <option value="{{ year }}" {% if anneeAdhesion == year %}selected{% endif %}>{{ year }}</option>
                                {% endfor %}
                            </select>
                        </div>#}

                        <div class="col-md-2">
                            <button type="submit" class="btn btn-cute w-100">
                                <i class="fas fa-filter me-1"></i> Filtrer
                            </button>
                        </div>

                        <div class="col-md-2">
                            <a href="{{ path('app_liste_index') }}" class="btn btn-outline-secondary w-100">
                                <i class="fas fa-undo me-1"></i> Réinitialiser
                            </a>
                        </div>

                    </div>
                </form>

        {# Affichage des filtres actifs #}
        {% if searchTerm or statut or filiere or cotFMTP or statutMenmbre or type or anneeAdhesion %}
            <div class="mb-3">
                <span class="text-muted small">Filtres actifs :</span>
                {% if searchTerm %}<span class="badge bg-secondary me-1">Recherche: {{ searchTerm }}</span>{% endif %}
                {% if statut %}<span class="badge bg-secondary me-1">Statut: {{ statut }}</span>{% endif %}
                {% if filiere %}<span class="badge bg-secondary me-1">Filière: {{ filiere }}</span>{% endif %}
                {% if cotFMTP %}<span class="badge bg-secondary me-1">Cotisation FMFP: {{ cotFMTP }}</span>{% endif %}
                {% if statutMenmbre %}<span class="badge bg-secondary me-1">Statut membre: {{ statutMenmbre == 'simple' ? 'Simple membre' : 'Membre du bureau' }}</span>{% endif %}
                {% if type %}<span class="badge bg-secondary me-1">Type: {{ type }}</span>{% endif %}
                {% if anneeAdhesion %}<span class="badge bg-secondary me-1">Année adhésion: {{ anneeAdhesion }}</span>{% endif %}
            </div>
        {% endif %}

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Nom</th>
                        <th>Email</th>
                        <th>Téléphone</th>
                        <th>Activité</th>
                        <th>Filière</th>
                        <th>Statut</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for liste in listes %}
                    <tr>
                        <td class="text-muted">#{{ liste.id }}</td>
                        <td class="fw-bold">{{ liste.nom }}</td>
                        <td>{{ liste.email }}</td>
                        <td>{{ liste.numero }}</td>
                        <td>{{ liste.activite }}</td>
                        <td>{{ liste.filiere }}</td>
                        <td>
                            {% if liste.statut == 'actif' %}
                                <span class="badge bg-success rounded-pill">Actif</span>
                            {% elseif liste.statut == 'inactif' %}
                                <span class="badge bg-warning rounded-pill">Inactif</span>
                            {% elseif liste.statut == 'radie' %}
                                <span class="badge bg-danger rounded-pill">Radié</span>
                            {% elseif liste.statut == 'demande' %}
                                <span class="badge bg-info rounded-pill">Demande</span>
                            {% else %}
                                <span class="badge bg-secondary rounded-pill">{{ liste.statut }}</span>
                            {% endif %}
                        </td>
                        <td class="text-end">
                            <div class="btn-group">
                                <a href="{{ path('app_liste_show', {'id': liste.id}) }}" 
                                   class="btn btn-sm btn-outline-secondary border-0 bg-light" 
                                   title="Voir">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="{{ path('app_liste_edit', {'id': liste.id}) }}" 
                                   class="btn btn-sm btn-outline-secondary border-0 bg-light ms-1" 
                                   title="Modifier">
                                    <i class="fas fa-edit"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="8" class="text-center py-5">
                            <div class="mb-3">
                                <i class="fas fa-users fa-4x text-muted opacity-25"></i>
                            </div>
                            <p class="text-muted fw-bold">
                                {% if searchTerm or statut or filiere or cotFMTP or statutMenmbre or type or anneeAdhesion %}
                                    Aucun adhérent ne correspond aux filtres sélectionnés.
                                {% else %}
                                    Aucun adhérent enregistré.
                                {% endif %}
                            </p>
                            <a href="{{ path('app_liste_new') }}" class="btn btn-primary mt-2">
                                <i class="fas fa-plus me-2"></i>Ajouter un adhérent
                            </a>
                        </td>
                    </table>
                {% endfor %}
                </tbody>
            </table>
        </div>
        
        {# Affichage du nombre de résultats #}
        <div class="mt-3 text-muted small">
            <i class="fas fa-list me-1"></i> {{ listes|length }} adhérent(s) trouvé(s)
        </div>
    </div>
</div>
{% endblock %}